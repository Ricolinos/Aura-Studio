    "installer-wizard-view.detener-proceso-mitad-puede-dejar-disco": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abbruch mittendrin kann die Festplatte des iPods fehlerhaft zurücklassen. Falls das passiert, starte das Installationsprogramm erneut, um sie zu reparieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping halfway can leave the iPod’s disk with errors. If that happens, run the installer again to repair it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener el proceso a la mitad puede dejar el disco del iPod con errores. Si eso pasa, vuelve a correr el instalador para repararlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter en cours de route peut laisser le disque de l’iPod avec des erreurs. Si cela arrive, relancez le programme d’installation pour le réparer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で停止すると、iPod のディスクにエラーが残ることがあります。その場合は、もう一度インストーラを実行すると修復できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановка на середине может оставить диск iPod с ошибками. Если это произойдёт, запустите установщик снова, чтобы его восстановить."
          }
        }
      }
    },
    "installing-view.no-desconectes-ipod-ni-cierres-aura": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh während dieses Schritts den iPod nicht ab und schließ Aura Studio nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t unplug the iPod or close Aura Studio during this step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No desconectes el iPod ni cierres Aura Studio durante este paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne débranchez pas l’iPod et ne fermez pas Aura Studio pendant cette étape."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手順の間は iPod を外したり Aura Studio を終了したりしないでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
