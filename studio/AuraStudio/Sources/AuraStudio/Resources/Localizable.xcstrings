            "value": "Marca la casilla de arriba para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez la case ci-dessus pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには上のチェックボックスをオンにしてください。"
          }
        },
