    },
    "albums-view.busca-varias-caratulas-cover-art-archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches Cover Art Archive and Deezer for several covers and applies the one you pick to every song on the album"
