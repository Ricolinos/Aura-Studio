    "themes-view.carpeta-con-fonts-e-icons-masks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder with fonts/ and icons/masks/ already generated -- for example, the output of the firmware's design-system/generate.py, or ~/Aura-local/theme-apple-source/design-system-out/."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta con fonts/ e icons/masks/ ya generados -- por ejemplo, la salida de design-system/generate.py del firmware, o ~/Aura-local/theme-apple-source/design-system-out/."
          }
        }
      }
    },
