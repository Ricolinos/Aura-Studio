    "media-section-view.se-quito-ipod-fuera-aura-studio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde außerhalb von Aura Studio vom iPod entfernt – es wird nicht von selbst wieder kopiert. Nimm „Auswahl synchronisieren“ im Kontextmenü, um es zurückzukopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was removed from the iPod outside Aura Studio -- it won’t be copied again on its own. Use “Sync selection” in the context menu to copy it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitó del iPod fuera de Aura Studio -- no se vuelve a copiar solo. Usa \"Sincronizar la selección\" en el menú contextual para volver a copiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été retiré de l’iPod en dehors d’Aura Studio — il ne sera pas recopié tout seul. Utilisez « Synchroniser la sélection » dans le menu contextuel pour le recopier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio 以外で iPod から削除されました。自動では再コピーされません。コンテキストメニューの「選択項目を同期」でコピーし直せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он был убран с iPod вне Aura Studio — сам он заново не скопируется. Используйте «Синхронизировать выбранное» в контекстном меню, чтобы скопировать его обратно."
          }
        }
      }
    },
