    "music-settings-view.separadores-que-agrupan-vs-versus-nunca": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trennzeichen, die zusammenfassen: %@. „vs.“ und „versus“ fassen nie zusammen, weil die Kollaboration dort einen eigenen Namen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separators that group: %@. “vs.” and “versus” never group, because there the collaboration has a name of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separadores que agrupan: %@. «vs.» y «versus» nunca agrupan, porque ahí la colaboración tiene nombre propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparateurs qui regroupent : %@. « vs. » et « versus » ne regroupent jamais, car la collaboration y porte un nom propre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめる区切り文字: %@。「vs.」と「versus」はまとめません。その場合、共演そのものが固有の名前だからです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделители, которые объединяют: %@. «vs.» и «versus» не объединяют никогда, потому что там у совместной работы своё собственное имя."
          }
        }
      }
    },
