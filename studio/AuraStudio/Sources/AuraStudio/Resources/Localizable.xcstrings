    "music-settings-view.gorillaz-feat-soul-se-agrupa-junto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Gorillaz feat. De La Soul“ wird mit „Gorillaz“ zusammengefasst: ein Interpret in der Liste und ein Foto. Die vollständigen Credits werden NICHT geändert – du siehst sie weiterhin in der Titelliste und unter „Weitere Informationen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Gorillaz feat. De La Soul” is grouped with “Gorillaz”: one artist in the list and one photo. The full credits are NOT changed -- you still see them in the songs table and in “More information”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Gorillaz feat. De La Soul» se agrupa junto a «Gorillaz»: un solo artista en la lista y una sola foto. Los créditos completos NO se modifican -- se siguen viendo en la tabla de canciones y en «Más información»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Gorillaz feat. De La Soul » est regroupé avec « Gorillaz » : un seul artiste dans la liste et une seule photo. Les crédits complets ne sont PAS modifiés — vous les voyez toujours dans le tableau des morceaux et dans « Plus d’informations »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Gorillaz feat. De La Soul」は「Gorillaz」にまとめられ、リスト上はひとりのアーティスト、写真も 1 枚になります。クレジット全体は変更されません。曲の一覧や「詳細情報」では引き続き表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Gorillaz feat. De La Soul» объединяется с «Gorillaz»: один исполнитель в списке и одно фото. Полные сведения об авторах НЕ меняются — вы по-прежнему видите их в таблице треков и в разделе «Подробнее»."
          }
        }
      }
    },
