    "settings.cover-art-album-only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per album"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una por album"
          }
        }
      }
