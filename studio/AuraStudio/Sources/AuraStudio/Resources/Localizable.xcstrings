    "photo-albums-view.dejarlo-vacio-disuelve-album-fotos-vuelv": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du es leer lässt, wird das Album aufgelöst – die Fotos landen wieder unter „Ohne Album“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving it empty dissolves the album -- the photos go back to “No album”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarlo vacío disuelve el álbum -- las fotos vuelven a \"Sin álbum\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le laisser vide dissout l’album — les photos retournent dans « Sans album »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のままにするとアルバムは解消され、写真は「アルバムなし」に戻ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оставить пустым, альбом распадётся — фото вернутся в «Без альбома»."
          }
        }
      }
    },
