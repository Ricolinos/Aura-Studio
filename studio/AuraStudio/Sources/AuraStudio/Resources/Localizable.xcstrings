    "extras-view.elige-cual-firmwares-instalables-usa-aur": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick which of the installable firmwares Aura Studio uses the next time you open the Installer. They are all free software (GPL v2), derived from Rockbox, and they share the same library: your music, photos and videos sync the same with any of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuál de los firmwares instalables usa Aura Studio la próxima vez que abras el Instalador. Todos son software libre (GPL v2), derivados de Rockbox, y comparten la misma biblioteca: tu música, fotos y videos se sincronizan igual con cualquiera."
          }
        }
      }
    },
    "extras-view.es-firmware-activo-tu-ipod": {
