          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser par catégorie dans la bibliothèque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリでカテゴリごとに整理"
          }
        },
        "ru": {
