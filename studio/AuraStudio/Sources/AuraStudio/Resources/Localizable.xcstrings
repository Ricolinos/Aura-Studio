    "device-general-view.tu-ipod-tiene-firmware-que-esta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPod has %@, a firmware this version of Aura Studio doesn't bundle. It tells you about its updates but can't apply them: download it from its repository and install it as usual. Your library is not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPod tiene %@, un firmware que esta versión de Aura Studio no trae embebido. Te avisa de sus actualizaciones pero no puede aplicarlas: descárgala de su repositorio e instálala como de costumbre. Tu biblioteca no se toca."
          }
        }
      }
    },
