    "device-general-view.esta-accion-no-se-puede-deshacer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen – vom iPod gelöschte Dateien sind nicht wiederherstellbar. Deine Mediathek auf diesem Mac bleibt unangetastet; du kannst jederzeit wieder synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone -- files deleted from the iPod can’t be recovered. Your library on this Mac is not touched; you can sync again whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer -- los archivos borrados del iPod no se pueden recuperar. Tu biblioteca en esta Mac no se toca; puedes volver a sincronizar cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible — les fichiers supprimés de l’iPod ne peuvent pas être récupérés. Votre bibliothèque sur ce Mac n’est pas touchée ; vous pouvez resynchroniser quand vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。iPod から削除したファイルは復元できません。この Mac のライブラリはそのままなので、いつでも再び同期できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие нельзя отменить — удалённые с iPod файлы не восстановить. Ваша медиатека на этом Mac не трогается; вы можете синхронизировать снова в любой момент."
          }
        }
      }
    },
    "device-general-view.esta-version-aura-studio-trae-mas": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Aura Studio bringt ein neueres %@ mit als das auf deinem iPod. Beim Aktualisieren gehen weder Musik noch Einstellungen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Aura Studio comes with a newer %@ than the one on your iPod. Updating does not erase your music or your settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Aura Studio trae un %@ más nuevo que el instalado en tu iPod. Actualizar no borra tu música ni tus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’Aura Studio contient un %@ plus récent que celui installé sur votre iPod. La mise à jour n’efface ni votre musique ni vos réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Aura Studio には、iPod に入っているものより新しい %@ が含まれています。アップデートしても音楽や設定は消えません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии Aura Studio есть более новая %@, чем установленная на вашем iPod. Обновление не удаляет ни музыку, ни настройки."
          }
        }
      }
    },
    "device-general-view.este-ipod-tiene-rockbox-que-no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPod läuft ein Rockbox, das nicht Aura ist: Die Aura-Studio-Mediathek gilt für diese Installation nicht. Im Bereich „Installation“ kannst du Aura installieren (ohne Flashen – es wird nur der Ordner .rockbox ersetzt) oder die Original-Firmware wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPod has a Rockbox that isn’t Aura: the Aura Studio library doesn’t apply to this install. In the Installer section you can install Aura (no flashing -- only the .rockbox folder is replaced) or restore the original firmware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPod tiene un Rockbox que no es Aura: la biblioteca de Aura Studio no aplica a esta instalacion. En la seccion Instalador puedes instalar Aura (sin flashear -- solo se reemplaza la carpeta .rockbox) o restaurar el firmware original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPod a un Rockbox qui n’est pas Aura : la bibliothèque d’Aura Studio ne s’applique pas à cette installation. Dans la section Installation, vous pouvez installer Aura (sans flasher — seul le dossier .rockbox est remplacé) ou restaurer le firmware d’origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPod には Aura ではない Rockbox が入っています。Aura Studio のライブラリはこのインストールには適用されません。「インストーラ」セクションで Aura をインストールする（フラッシュはせず .rockbox フォルダを置き換えるだけです）か、純正ファームウェアを復元できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPod установлен Rockbox, который не является Aura: медиатека Aura Studio к этой установке не относится. В разделе «Установка» можно установить Aura (без прошивки — заменяется только папка .rockbox) или восстановить оригинальную прошивку."
          }
        }
      }
    },
