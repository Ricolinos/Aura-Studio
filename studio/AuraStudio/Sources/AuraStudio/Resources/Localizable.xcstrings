    "photo-settings-view.pantalla-ipod-es-320x240-foto-camara": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPod's screen is 320x240 -- a photo from a current camera or phone weighs dozens of times more than that screen can show. “Save space” reduces every photo to 320px on its longest side, the screen's native width. “HD version” leaves it at 640px: a little sharper when you zoom in the viewer, in exchange for more space on the iPod. Either way it is saved as a compressed JPEG, never the full original photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla del iPod es de 320x240 -- una foto de una cámara o teléfono actual pesa decenas de veces más de lo que esa pantalla puede mostrar. \"Optimizar espacio\" reduce cada foto a 320px de lado mayor, el ancho nativo de la pantalla. \"Versión HD\" la deja en 640px: se ve un poco más nítida al hacer zoom en el visor, a cambio de más espacio en el iPod. En ambos casos se guarda como JPEG comprimido, nunca la foto original completa."
          }
        }
      }
    },
    "photo-settings-view.separa-tus-fotos-colecciones-imagenes-fo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits your photos into collections (Images, Photos and AI by default, editable below) so they're easier to find INSIDE Aura Studio -- the collection is suggested on import, and you can correct it by hand in Library → Photos. With this on, each collection is also a folder inside “Images” in the library's local folder (Finder). It doesn't change where they end up on the iPod: there they are always copied together into “Photos”, because the iPod's viewer doesn't browse subfolders yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa tus fotos en colecciones (Imágenes, Fotos e IA por defecto, editables abajo) para encontrarlas más fácil DENTRO de Aura Studio -- la colección se sugiere sola al importar, y se puede corregir a mano en Biblioteca → Fotos. Con este ajuste activo, cada colección es ademas una carpeta dentro de \"Imágenes\" en la carpeta local de la biblioteca (Finder). No cambia dónde quedan en el iPod: ahí siempre se copian juntas en \"Photos\", porque el visor del iPod todavía no navega por subcarpetas."
          }
        }
      }
    },
    "photo-settings-view.version-hd-640px": {
