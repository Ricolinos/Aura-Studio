    "settings.language-apply-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache wechselt, wenn du die App wieder öffnest; an deiner Mediathek und deinem iPod wird nichts angerührt. Wählst du „Später“, bleibt die Einstellung gespeichert und gilt beim nächsten Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language changes when you reopen the app, and nothing in your library or on your iPod is touched. If you choose “Later”, the setting stays saved and applies the next time you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma cambia al volver a abrir la app, y no se toca nada de tu biblioteca ni de tu iPod. Si eliges «Más tarde», el ajuste queda guardado y se aplica la próxima vez que la abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue change à la réouverture de l’app, et rien dans votre bibliothèque ni sur votre iPod n’est modifié. Si vous choisissez « Plus tard », le réglage reste enregistré et s’applique à la prochaine ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語はアプリを開き直したときに変わります。ライブラリや iPod には何も手を加えません。「あとで」を選ぶと設定は保存され、次に開いたときに適用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык меняется при повторном открытии приложения, и ничего в вашей медиатеке или на iPod не затрагивается. Если выбрать «Позже», настройка сохранится и применится при следующем открытии."
          }
        }
      }
    },
    "settings.language-apply-title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio jetzt schließen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Aura Studio now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar Aura Studio ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer Aura Studio maintenant ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio を今すぐ終了しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть Aura Studio сейчас?"
          }
        }
      }
    },
    "settings.language-busy-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es laufen gerade Aufgaben: Synchronisieren, Umwandeln, Migrieren oder Firmware. Die Sprache bleibt gespeichert und gilt, wenn du Aura Studio das nächste Mal öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are tasks running: syncing, conversion, migration or firmware. The language stays saved and applies the next time you open Aura Studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay tareas en curso: sincronización, conversión, migración o firmware. El idioma queda guardado y se aplica la próxima vez que abras Aura Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tâches sont en cours : synchronisation, conversion, migration ou micrologiciel. La langue reste enregistrée et s’appliquera à la prochaine ouverture d’Aura Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のタスクがあります（同期、変換、移行、ファームウェア）。言語設定は保存され、次に Aura Studio を開いたときに適用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняются задачи: синхронизация, преобразование, миграция или прошивка. Настройка языка сохранена и применится при следующем открытии Aura Studio."
          }
        }
      }
    },
