    "extras-view.tu-ipod-tiene-instalar-lo-agrega": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem iPod ist %@. Wenn du %@ installierst, kommt es dazu: %@ bleibt mit seinen Einstellungen im Ruhezustand, und du kannst von hier aus dorthin zurückwechseln, ohne noch einmal etwas zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPod has %@. Installing %@ adds it: %@ is kept asleep with its settings and you’ll be able to come back to it from here without installing anything again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPod tiene %@. Instalar %@ lo agrega: %@ se guarda dormido con sus ajustes y podrás volver a él desde aquí sin volver a instalar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPod a %@. Installer %@ l’ajoute : %@ reste en veille avec ses réglages et vous pourrez y revenir d’ici sans rien réinstaller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod には %@ が入っています。%@ をインストールすると追加され、%@ は設定を保ったままスリープ状態で残ります。何も入れ直さずに、ここから戻せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем iPod установлена %@. Установка %@ добавит её: %@ останется в спящем виде со своими настройками, и вы сможете вернуться к ней отсюда, ничего не устанавливая заново."
          }
        }
      }
    },
    "extras-view.ya-esta-instalado-tu-ipod-dormido": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits auf deinem iPod installiert, im Ruhezustand und mit gespeicherten Einstellungen. Das Wechseln dauert eine Sekunde (es wird nichts geladen oder gelöscht); danach musst du den iPod neu starten, und beim ersten Mal baut er seine Musikdatenbank neu auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already installed on your iPod, asleep, with its settings saved. Switching takes a second (it doesn’t download or erase anything); afterwards you have to restart the iPod, and the first time it rebuilds its music database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está instalado en tu iPod, dormido, con sus ajustes guardados. Cambiar toma un segundo (no descarga ni borra nada); después hay que reiniciar el iPod y la primera vez reconstruye su base de música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà installé sur votre iPod, en veille, avec ses réglages enregistrés. Basculer prend une seconde (rien n’est téléchargé ni effacé) ; ensuite il faut redémarrer l’iPod, et la première fois il reconstruit sa base musicale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに iPod にインストールされ、設定を保ったままスリープ状態です。切り替えは一瞬で終わり（ダウンロードも削除もしません）、そのあと iPod を再起動する必要があります。初回は音楽データベースを作り直します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже установлена на вашем iPod, в спящем виде и с сохранёнными настройками. Переключение занимает секунду (ничего не загружается и не удаляется); после этого нужно перезапустить iPod, и в первый раз он заново соберёт свою музыкальную базу."
          }
        }
      }
    },
