    "media-section-view.imagen-es-tu-biblioteca-parecen-caratula": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Bild(er) in deiner Mediathek sehen wie Albumcover aus, nicht wie Fotos. Willst du sie durchsehen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
