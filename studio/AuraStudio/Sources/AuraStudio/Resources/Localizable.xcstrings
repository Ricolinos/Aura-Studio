    "album-cover-picker-view.deja-este-album-como-esta-pasa": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt dieses Album unverändert und geht zum nächsten weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this album as it is and move on to the next one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja este álbum como está y pasa al siguiente de la lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse cet album tel quel et passe au suivant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムはそのままにして次に進みます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет этот альбом как есть и переходит к следующему"
          }
        }
      }
    },
    "album-cover-picker-view.no-se-encontraron-caratulas-para-este": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Album wurden keine Cover gefunden."
