    "media-section-view.para-convertir-videos-al-formato-ipod": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umwandeln von Videos in das iPod-Format wird ffmpeg gebraucht. Installier es mit Homebrew („brew install ffmpeg“) und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converting videos to the iPod’s format needs ffmpeg. Install it with Homebrew (“brew install ffmpeg”) and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir videos al formato del iPod hace falta ffmpeg. Instálalo con Homebrew (\"brew install ffmpeg\") y vuelve a intentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir des vidéos au format de l’iPod nécessite ffmpeg. Installez-le avec Homebrew (« brew install ffmpeg ») et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを iPod の形式に変換するには ffmpeg が必要です。Homebrew でインストールして（「brew install ffmpeg」）、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для преобразования видео в формат iPod нужен ffmpeg. Установите его через Homebrew («brew install ffmpeg») и повторите."
          }
        }
      }
    },
