    "settings.fetch-lyrics-detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Liedtexte mit Zeitmarken, damit sie beim Abspielen auf dem Bildschirm mitlaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads timed lyrics so they follow along on screen while the song plays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga letras con tiempos para que se sigan en pantalla mientras suena la cancion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge des paroles minutées pour qu’elles défilent à l’écran pendant la lecture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング付きの歌詞をダウンロードし、曲の再生に合わせて画面で追えるようにします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает тексты с тайм-кодами, чтобы они шли по экрану во время воспроизведения."
          }
        }
      }
    },
