    "media-info-view.nombre-destino-ipod-se-arma-con": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zielname auf dem iPod wird aus diesen drei Feldern gebildet – wenn du sie änderst und erneut synchronisierst, wird die Folge in Movie Flow neu gruppiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination name on the iPod is built from these three fields -- changing them and syncing again regroups the episode in Movie Flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de destino en el iPod se arma con estos tres campos -- cambiarlos y sincronizar de nuevo reagrupa el episodio en Movie Flow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de destination sur l’iPod se construit à partir de ces trois champs — les modifier puis resynchroniser regroupe l’épisode dans Movie Flow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod 上のファイル名はこの 3 つの項目から作られます。変更して同期し直すと、Movie Flow でエピソードがまとめ直されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя файла на iPod складывается из этих трёх полей — если изменить их и синхронизировать снова, серия перегруппируется в Movie Flow."
          }
        }
      }
    },
    "media-info-view.se-guarda-junto-cancion-se-muestra": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird neben dem Titel gesichert und beim Abspielen auf dem iPod angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved next to the song and shown on screen while it plays on the iPod."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda junto a la canción y se muestra en pantalla mientras suena en el iPod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré à côté du morceau et affiché à l’écran pendant la lecture sur l’iPod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲のとなりに保存され、iPod で再生中に画面に表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется рядом с треком и показывается на экране во время воспроизведения на iPod."
          }
        }
      }
    },
    "media-info-view.se-sincroniza-con-ipod-misma-calificacio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird mit dem iPod synchronisiert: dieselbe Bewertung, die du hier oder unter „Aktueller Titel“ am Gerät vergibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs with the iPod: the same rating you pick here or in the device’s “Now Playing”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con el iPod: la misma calificación que se elige acá o en \"Ahora suena\" del aparato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se synchronise avec l’iPod : la même note que celle choisie ici ou dans « En cours de lecture » sur l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod と同期します。ここで付ける評価と、本体の「再生中」で付ける評価は同じものです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируется с iPod: та же оценка, что вы ставите здесь или в разделе «Сейчас играет» на устройстве."
          }
        }
      }
    },
    "media-info-view.titulo-artista-album-son-obligatorios-pa": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Interpret und Album sind zum Synchronisieren erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title, artist and album are required to sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista y álbum son obligatorios para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre, l’artiste et l’album sont obligatoires pour synchroniser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期にはタイトル、アーティスト、アルバムが必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название, исполнитель и альбом обязательны для синхронизации."
          }
        }
      }
    },
    "media-section-view.aura-studio-ahora-lee-mejor-etiquetas": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio liest die Tags deiner Dateien jetzt besser. Sollen die %lld Titel deiner Mediathek erneut gelesen werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio now reads the tags in your files better. Do you want to read the %lld song(s) in your library again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio ahora lee mejor las etiquetas de tus archivos. ¿Quieres volver a leer las %lld canción(es) de tu biblioteca?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio lit maintenant mieux les tags de vos fichiers. Voulez-vous relire les %lld morceau(x) de votre bibliothèque ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio はファイルのタグをより正確に読めるようになりました。ライブラリの %lld 曲を読み直しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio теперь лучше читает теги ваших файлов. Прочитать заново %lld трек(ов) вашей медиатеки?"
          }
        }
      }
    },
    "media-section-view.busca-poster-tmdb-fanart-tv-necesita": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht das Poster auf TMDB und fanart.tv (braucht den TMDB-API-Key unter Einstellungen › Dienste) und kopiert es neben das Video auf den iPod"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks the poster up on TMDB and fanart.tv (needs the TMDB API key in Settings › Services) and copies it next to the video on the iPod"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el póster en TMDB y fanart.tv (necesita la API key de TMDB en Ajustes › Servicios) y lo copia junto al video en el iPod"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche l’affiche sur TMDB et fanart.tv (nécessite la clé d’API TMDB dans Réglages › Services) et la copie à côté de la vidéo sur l’iPod"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB と fanart.tv でポスターを探し（設定 › サービスに TMDB の API キーが必要です）、iPod のビデオのとなりにコピーします"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет постер на TMDB и fanart.tv (нужен ключ API TMDB в разделе Настройки › Сервисы) и копирует его рядом с видео на iPod"
          }
        }
      }
    },
