      }
    },
    "library-unavailable-view.no-se-perdio-nada-tu-catalogo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nichts verloren: Dein Katalog und deine Dateien liegen weiterhin auf dieser Festplatte. Aura Studio rührt nichts an, bis sie wieder verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was lost: your catalog and your files are still on that disk. Aura Studio won’t touch anything until it’s available again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se perdió nada: tu catálogo y tus archivos siguen en ese disco. Aura Studio no va a tocar nada hasta que vuelva a estar disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est perdu : votre catalogue et vos fichiers sont toujours sur ce disque. Aura Studio n’y touchera pas tant qu’il ne sera pas de nouveau disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も失われていません。カタログもファイルもそのディスクに残っています。再び利用できるようになるまで、Aura Studio は何も触りません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не потеряно: ваш каталог и файлы остаются на этом диске. Aura Studio ничего не тронет, пока он снова не станет доступен."
          }
        }
      }
    },
