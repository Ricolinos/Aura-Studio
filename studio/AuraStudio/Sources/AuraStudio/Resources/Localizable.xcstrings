    "cover-normalization-bar.caratulas-tu-biblioteca-pasan-ser-cuadra": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cover deiner Mediathek werden quadratisch, so wie der iPod sie zeigt. Deine Originaldateien bleiben unangetastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cover art in your library becomes square, the way the iPod shows it. Your original files are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carátulas de tu biblioteca pasan a ser cuadradas, como las muestra el iPod. Tus archivos originales no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pochettes de votre bibliothèque deviennent carrées, comme l’iPod les affiche. Vos fichiers d’origine ne sont pas touchés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリのアートワークが、iPod での表示に合わせて正方形になります。元のファイルはそのままです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обложки вашей медиатеки станут квадратными, как их показывает iPod. Ваши исходные файлы не трогаются."
          }
        }
      }
    },
    "cover-normalization-bar.detiene-normalizacion-lo-que-ya-se": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt das Normalisieren. Was schon erledigt ist, bleibt erledigt; der Rest läuft weiter, wenn du die Mediathek das nächste Mal öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops normalizing. What is already done stays done, and the rest continues the next time you open the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la normalización. Lo que ya se hizo queda hecho y el resto sigue la próxima vez que abras la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la normalisation. Ce qui est déjà fait reste fait, et le reste continue à la prochaine ouverture de la bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理を停止します。済んだぶんはそのまま残り、残りは次にライブラリを開いたときに続きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает приведение. Сделанное остаётся сделанным, остальное продолжится при следующем открытии медиатеки."
          }
        }
      }
    },
