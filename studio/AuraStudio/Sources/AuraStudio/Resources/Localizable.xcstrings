    "services-settings-view.caratula-alternativa-1000x1000-sin-key-e": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative Cover, 1000 × 1000. Ohne Key – es ist die einzige Quelle, deren Bedingungen die nicht kommerzielle Nutzung ausdrücklich erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative cover art, 1000x1000. No key -- it is the only source whose terms explicitly allow non-commercial use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caratula alternativa, 1000x1000. Sin key -- es la unica fuente cuyos terminos permiten explicitamente el uso no comercial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochette alternative, 1000 × 1000. Sans clé — c’est la seule source dont les conditions autorisent explicitement l’usage non commercial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替のアートワーク、1000×1000。キー不要 — 非商用利用を明示的に許可している唯一の提供元です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернативные обложки, 1000 × 1000. Без ключа — это единственный источник, условия которого прямо разрешают некоммерческое использование."
          }
        }
      }
    },
    "services-settings-view.como-conseguir-key": {
