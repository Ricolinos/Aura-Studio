    "themes-view.este-tema-se-construye-solo-para": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Thema wird nur für deinen eigenen iPod erstellt: Teile oder verbreite es nicht – die Lizenz dieser Assets erlaubt das außerhalb deines Geräts nicht. Aura Studio enthält diese Dateien nie und lädt sie nie; es verwendet nur die, die dein Mac schon hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This theme is built only for your own iPod: don’t share or distribute it -- the license of those assets doesn’t allow it outside your device. Aura Studio never includes or downloads these files; it only uses the ones your Mac already has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema se construye solo para tu propio iPod: no lo compartas ni lo distribuyas -- la licencia de esos assets no lo permite fuera de tu dispositivo. Aura Studio nunca incluye ni descarga estos archivos; solo usa los que tu Mac ya tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème est construit uniquement pour votre propre iPod : ne le partagez pas et ne le distribuez pas — la licence de ces ressources ne l’autorise pas en dehors de votre appareil. Aura Studio n’inclut ni ne télécharge jamais ces fichiers ; il n’utilise que ceux que votre Mac possède déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマはあなた自身の iPod のためだけにビルドされます。共有や配布はしないでください。これらのアセットのライセンスは、あなたのデバイスの外での利用を認めていません。Aura Studio がこれらのファイルを同梱したりダウンロードしたりすることはありません。あなたの Mac にすでにあるものだけを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема собирается только для вашего собственного iPod: не делитесь ею и не распространяйте её — лицензия этих ресурсов не допускает этого за пределами вашего устройства. Aura Studio никогда не включает и не загружает эти файлы; она использует только те, что уже есть на вашем Mac."
          }
        }
      }
    },
    "themes-view.esto-borra-tema-ipod-si-estaba": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird das Thema vom iPod gelöscht. War es aktiv, ist Aura wieder das eingebaute Thema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the theme from the iPod. If it was active, Aura goes back to being the built-in theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra el tema del iPod. Si estaba activo, Aura vuelve a ser el tema integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le thème de l’iPod. S’il était actif, Aura redevient le thème intégré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマを iPod から削除します。使用中だった場合、Aura は内蔵テーマに戻ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит тему с iPod. Если она была активной, Aura снова станет встроенной темой."
          }
        }
      }
    },
    "themes-view.no-se-pudo-completar-operacion": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang konnte nicht abgeschlossen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the operation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’opération"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить операцию"
          }
        }
      }
    },
    "themes-view.se-aplican-ipod-al-arrancar-tema": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden auf dem iPod beim Start angewendet. Ein Thema, das nicht lädt (inkompatibles Format oder fehlende Dateien), erscheint ausgegraut – die Firmware tut nie so, als könnte sie etwas, das sie nicht hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They’re applied on the iPod at startup. A theme that doesn’t load (incompatible format or missing files) shows dimmed -- the firmware never pretends to support what it doesn’t have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplican en el iPod al arrancar. Un tema que no carga (formato incompatible o archivos faltantes) aparece atenuado -- el firmware nunca finge soportar lo que no tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils s’appliquent sur l’iPod au démarrage. Un thème qui ne se charge pas (format incompatible ou fichiers manquants) apparaît grisé — le firmware ne fait jamais semblant de prendre en charge ce qu’il n’a pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod の起動時に適用されます。読み込めないテーマ（対応していない形式やファイル不足）は淡く表示されます。ファームウェアは、備えていないものに対応しているふりをしません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они применяются на iPod при запуске. Тема, которая не загружается (несовместимый формат или недостающие файлы), показана серой — прошивка никогда не делает вид, что поддерживает то, чего у неё нет."
          }
        }
      }
    },
    "themes-view.tema": {
