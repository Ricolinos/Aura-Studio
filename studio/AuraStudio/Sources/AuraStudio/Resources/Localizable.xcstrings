    "licenses-view.aura-studio-es-gratuita-se-distribuye": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio is free and distributed non-commercially. It bundles, exactly as they were published and unmodified, the installable firmwares for the iPod Classic 6G, all free software under the GNU General Public License version 2 (GPL v2). Each one is derived from Rockbox; its complete source code, the exact version included here and the record of changes against Rockbox are in the links below, as section 3 of that license requires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio es gratuita y se distribuye sin fines comerciales. Trae embebidos, tal cual se publicaron y sin modificarlos, los firmwares instalables para iPod Classic 6G, todos software libre bajo la Licencia Pública General de GNU versión 2 (GPL v2). Cada uno es un derivado de Rockbox; su código fuente completo, la versión exacta incluida aquí y el registro de cambios respecto a Rockbox están en los enlaces de abajo, como exige la sección 3 de esa licencia."
          }
        }
      }
    },
