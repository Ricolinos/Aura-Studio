    "album-cover-picker-view.caratulas-para": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover art for “%@”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carátulas para «%@»"
          }
        }
      }
    },
    "album-cover-picker-view.deja-este-album-como-esta-pasa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this album as it is and move on to the next one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja este álbum como está y pasa al siguiente de la lista"
          }
        }
      }
    },
    "album-cover-picker-view.no-se-encontraron-caratulas-para-este": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cover art was found for this album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron carátulas para este álbum."
          }
        }
      }
    },
    "album-cover-picker-view.omitir-este-album": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this album"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir este álbum"
          }
        }
      }
    },
    "album-cover-picker-view.recomendada": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendada"
          }
        }
      }
    },
    "album-cover-picker-view.revisa-que-titulo-artista-album-esten": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the album title and artist are spelled correctly; you can also turn on Deezer in Settings › Services to get more results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa que el título y el artista del álbum estén bien escritos; también puedes activar Deezer en Ajustes › Servicios para tener más resultados."
          }
        }
      }
    },
    "album-cover-picker-view.usar-esta-caratula": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this cover"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar esta carátula"
          }
        }
      }
    },
    "album-cover-picker-view.usar-recomendada": {
      "extractionState": "manual",
      "localizations": {
