    "settings-section-view.carpetas-externas-que-arrastraste-aura-c": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External folders you dragged into Aura with “Copy media into the Aura Library” off -- Aura copies nothing from there, it only remembers them here. Removing a folder from this list doesn't delete or unlink what you already imported from it, it just stops showing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas externas que arrastraste a Aura con \"Crear copias de los medios...\" apagado -- Aura no copia nada de ahí, solo las recuerda acá. Quitar una carpeta de esta lista no borra ni desvincula lo que ya importaste desde ella, solo deja de mostrarla."
          }
        }
      }
    },
    "settings-section-view.crear-copias-medios-biblioteca-aura": {
