        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они будут удалены с iPod. Ваша медиатека на Mac не изменится."
          }
        }
      }
    },
    "themes-view.carpeta-con-fonts-e-icons-masks": {
