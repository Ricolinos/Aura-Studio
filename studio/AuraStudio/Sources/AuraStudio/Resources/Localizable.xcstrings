    "content-view.vuelve-leer-estado-ipod-tu-biblioteca": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Zustand deines iPods und deiner Mediathek neu ein. Es wird nichts kopiert oder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the state of your iPod and your library again. It doesn’t copy or delete anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer el estado del iPod y de tu biblioteca. No copia ni borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit l’état de votre iPod et de votre bibliothèque. Ne copie ni ne supprime rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod とライブラリの状態を読み直します。コピーも削除もしません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заново считывает состояние вашего iPod и медиатеки. Ничего не копирует и не удаляет."
          }
        }
      }
    },
