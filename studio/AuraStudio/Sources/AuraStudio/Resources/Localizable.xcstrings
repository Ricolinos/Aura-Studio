    "orphans-confirm-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are not tied to any item in your library; deleting them affects no song, photo or video you have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No están ligados a ningún elemento de tu biblioteca; borrarlos no afecta ninguna canción, foto ni video que tengas."
          }
        }
      }
    },
    "orphans-detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared files and cover art that no longer belong to any item in your library — from items deleted before this version, or from reprocessing. They are not your original files: they are technical copies Aura makes on its own and can make again if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparados y carátulas que ya no le pertenecen a ningún elemento de tu biblioteca — de elementos eliminados antes de esta versión, o de un reprocesamiento. No son tus archivos originales: son copias técnicas que Aura arma sola y puede volver a armar si hicieran falta."
          }
        }
      }
    },
