    "device-general-view.tu-ipod-tiene-firmware-que-esta": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem iPod ist %@, eine Firmware, die diese Version von Aura Studio nicht mitbringt. Sie informiert dich über Updates, kann sie aber nicht einspielen: Lade sie aus ihrem Repository und installiere sie wie gewohnt. Deine Mediathek bleibt unangetastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPod has %@, a firmware this version of Aura Studio doesn’t bundle. It tells you about its updates but can’t apply them: download it from its repository and install it as usual. Your library is not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPod tiene %@, un firmware que esta versión de Aura Studio no trae embebido. Te avisa de sus actualizaciones pero no puede aplicarlas: descárgala de su repositorio e instálala como de costumbre. Tu biblioteca no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPod a %@, un firmware que cette version d’Aura Studio n’embarque pas. Elle vous signale ses mises à jour mais ne peut pas les appliquer : téléchargez-la depuis son dépôt et installez-la comme d’habitude. Votre bibliothèque n’est pas touchée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod には %@ が入っています。このバージョンの Aura Studio には同梱されていないファームウェアです。アップデートはお知らせできますが適用はできません。リポジトリからダウンロードして、いつもどおりインストールしてください。ライブラリはそのままです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем iPod установлена %@ — прошивка, которой нет в этой версии Aura Studio. Она сообщает о её обновлениях, но не может их применить: скачайте её из репозитория и установите как обычно. Ваша медиатека не трогается."
          }
        }
      }
    },
