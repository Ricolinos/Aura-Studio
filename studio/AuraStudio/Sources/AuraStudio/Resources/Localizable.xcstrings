    "app-update-bar.baja-aura-studio-no-se-actualiza": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt %@ herunter. Aura Studio aktualisiert sich nicht selbst: Öffne es nach dem Download und zieh die App in „Programme“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads %@. Aura Studio does not update itself: when it finishes, open it and drag the app to Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja %@. Aura Studio no se actualiza sola: cuando termine, ábrelo y arrastra la app a Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge %@. Aura Studio ne se met pas à jour tout seul : une fois le téléchargement terminé, ouvrez-le et faites glisser l’app dans Applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をダウンロードします。Aura Studio は自動では更新されません。完了したら開いて、アプリを「アプリケーション」にドラッグしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает %@. Aura Studio не обновляется сама: когда загрузка закончится, откройте файл и перетащите приложение в «Программы»."
          }
        }
      }
    },
