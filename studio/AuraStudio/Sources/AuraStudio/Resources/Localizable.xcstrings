    "licenses-view.todos-firmwares-su-bootloader-dual-boot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the firmwares, their dual-boot boot loader and the mks5lboot flashing tool derive from the Rockbox project (GPL v2). Aura Studio does not modify any of those binaries."
          }
        },
        "es": {
          "stringUnit": {
