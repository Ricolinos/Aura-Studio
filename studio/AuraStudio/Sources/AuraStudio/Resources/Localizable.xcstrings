    "orphans-confirm-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gehören zu keinem Objekt deiner Mediathek; sie zu löschen betrifft keinen Titel, kein Foto und kein Video, das du hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are not tied to any item in your library; deleting them affects no song, photo or video you have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No están ligados a ningún elemento de tu biblioteca; borrarlos no afecta ninguna canción, foto ni video que tengas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne sont liés à aucun élément de votre bibliothèque ; les supprimer n’affecte aucun morceau, photo ou vidéo que vous possédez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはライブラリのどの項目にも結び付いていません。削除しても、お持ちの曲・写真・ビデオには影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не связаны ни с одним объектом вашей медиатеки; их удаление не затронет ни один трек, фото или видео."
          }
        }
      }
    },
    "orphans-detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbereitete Dateien und Cover, die zu keinem Objekt deiner Mediathek mehr gehören – von Objekten, die vor dieser Version gelöscht wurden, oder von einer erneuten Verarbeitung. Es sind nicht deine Originaldateien: Es sind technische Kopien, die Aura selbst anlegt und bei Bedarf neu anlegen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared files and cover art that no longer belong to any item in your library — from items deleted before this version, or from reprocessing. They are not your original files: they are technical copies Aura makes on its own and can make again if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparados y carátulas que ya no le pertenecen a ningún elemento de tu biblioteca — de elementos eliminados antes de esta versión, o de un reprocesamiento. No son tus archivos originales: son copias técnicas que Aura arma sola y puede volver a armar si hicieran falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers préparés et pochettes qui n’appartiennent plus à aucun élément de votre bibliothèque — issus d’éléments supprimés avant cette version, ou d’un retraitement. Ce ne sont pas vos fichiers d’origine : ce sont des copies techniques qu’Aura crée seul et peut recréer si besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリのどの項目にも属さなくなった準備済みファイルとアートワークです。このバージョンより前に削除された項目や、再処理の結果として残ったものです。元のファイルではありません。Aura が自分で作る技術的なコピーで、必要になればまた作れます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовленные файлы и обложки, которые больше не принадлежат ни одному объекту вашей медиатеки — от объектов, удалённых до этой версии, или после повторной обработки. Это не ваши исходные файлы: это технические копии, которые Aura создаёт сама и при необходимости создаст заново."
          }
        }
      }
    },
    "orphans-none-found": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
