    "restore-handoff-view.ipod-quedo-listo-se-quito-bootloader": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iPod ist fertig: Der Aura-Bootloader wurde entfernt und die Festplatte in dem Format vorbereitet, das der Finder erwartet (Mac OS Extended, journaled, GUID-Partitionstabelle)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPod is ready: the Aura boot loader was removed and the disk was prepared in the format Finder expects (Mac OS Extended journaled, GUID map)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPod quedo listo: se quito el bootloader de Aura y el disco se preparo en el formato que Finder espera (Mac OS Plus con registro, mapa GUID)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPod est prêt : le bootloader d’Aura a été retiré et le disque a été préparé au format attendu par le Finder (Mac OS étendu journalisé, table GUID)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod の準備ができました。Aura のブートローダーを取り除き、ディスクを Finder が想定する形式（Mac OS 拡張（ジャーナリング）、GUID パーティションマップ）で用意しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod готов: загрузчик Aura удалён, а диск подготовлен в формате, который ожидает Finder (Mac OS Extended с журналом, схема GUID)."
          }
        }
      }
    },
