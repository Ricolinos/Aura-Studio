    "device-general-view.mientras-tanto-puedes-ir-armando-bibliot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Zwischenzeit kannst du deine Mediathek unter Musik, Video und Fotos aufbauen: Sie wird synchronisiert, sobald du das Gerät anschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the meantime you can start building your library in Music, Video and Photos: it syncs when you connect the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras tanto puedes ir armando la biblioteca en Musica, Video y Fotos: se sincroniza cuando conectes el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attendant, vous pouvez constituer votre bibliothèque dans Musique, Vidéo et Photos : elle se synchronise dès que vous branchez l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間に「音楽」「ビデオ」「写真」でライブラリを作れます。デバイスを接続すると同期されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем временем вы можете собирать медиатеку в разделах «Музыка», «Видео» и «Фото»: она синхронизируется, как только вы подключите устройство."
          }
        }
      }
    },
    "device-general-view.musica-este-ipod-administra-firmware-ori": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik auf diesem iPod verwaltet Apples Original-Firmware – sie wird mit dem Finder (oder der Musik-App) synchronisiert, nicht mit Aura Studio. Wenn du Aura im Bereich „Installation“ installierst, wird die Aura-Studio-Mediathek aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music on this iPod is managed by Apple’s original firmware -- it syncs with Finder (or the Music app), not with Aura Studio. If you install Aura from the Installer section, the Aura Studio library turns on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica de este iPod la administra el firmware original de Apple -- se sincroniza con Finder (o la app Musica), no con Aura Studio. Si instalas Aura desde la seccion Instalador, la biblioteca de Aura Studio se activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique de cet iPod est gérée par le firmware d’origine d’Apple — elle se synchronise avec le Finder (ou l’app Musique), pas avec Aura Studio. Si vous installez Aura depuis la section Installation, la bibliothèque d’Aura Studio s’active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPod の音楽は Apple 純正ファームウェアが管理しています。同期は Aura Studio ではなく Finder（またはミュージックアプリ）で行います。「インストーラ」セクションから Aura をインストールすると、Aura Studio のライブラリが有効になります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыкой на этом iPod управляет оригинальная прошивка Apple — она синхронизируется через Finder (или приложение «Музыка»), а не через Aura Studio. Если установить Aura в разделе «Установка», медиатека Aura Studio включится."
          }
        }
      }
    },
    "device-general-view.nombre-este-ipod-se-puso-desde": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser iPod wurde von einem anderen Mac benannt; nur dort lässt sich der Name ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPod was named from another Mac; it can only be renamed from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de este iPod se puso desde otra Mac; solo desde ahí se puede cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPod a été nommé depuis un autre Mac ; il ne peut être renommé que de là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPod の名前は別の Mac で設定されました。変更もそちらからのみ行えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя этого iPod было задано с другого Mac; изменить его можно только оттуда."
          }
        }
      }
    },
