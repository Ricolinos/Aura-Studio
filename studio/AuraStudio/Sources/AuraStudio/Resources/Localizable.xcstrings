    "library-view-model.eliminar-copia-papelera": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ werden in den Papierkorb verschoben (%2$@). Von dort kannst du sie zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will be moved to the Trash (%2$@). You can get them back from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se moverán %1$@ a la Papelera (%2$@). Puedes recuperarlos desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ seront déplacés vers la Corbeille (%2$@). Vous pourrez les récupérer depuis là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ をゴミ箱に移動します（%2$@）。そこから元に戻せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ будут перемещены в Корзину (%2$@). Оттуда их можно восстановить."
          }
        }
      }
    },
    "library-view-model.eliminar-referencia-uno": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird aus deiner Aura-Mediathek entfernt. Die Originaldatei bleibt, wo sie ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from your Aura library. The original file stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitará de tu biblioteca de Aura. El archivo original se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera retiré de votre bibliothèque Aura. Le fichier d’origine reste où il est."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura のライブラリから取り除かれます。元のファイルはそのままです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет убран из вашей медиатеки Aura. Исходный файл останется на месте."
          }
        }
      }
    },
    "library-view-model.eliminar-referencia-varios": {
