    "done-view.detectamos-que-firmware-ya-habia-estado": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found that the firmware had been installed before, so we only updated the files without writing the boot loader again. If your iPod does NOT start with %@ when you unplug the cable, the boot loader was lost since that earlier install and has to be written again over DFU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectamos que el firmware ya había estado instalado antes, así que solo actualizamos los archivos sin volver a grabar el arranque. Si al desconectar el cable tu iPod NO arranca con %@, el arranque se perdió desde la instalación anterior y hace falta grabarlo de nuevo por DFU."
          }
        }
      }
    },
    "done-view.instalar-solo-este-firmware-ipod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install only this firmware on the iPod"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar solo este firmware en el iPod"
          }
        }
      }
    },
    "done-view.instalaste-modo-dual-boot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
