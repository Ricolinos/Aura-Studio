    "similar-items.confianza.duplicado-detalle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ziemlicher Sicherheit dieselbe Datei zweimal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost certainly the same file twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi seguro es el mismo archivo dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque certainement le même fichier en double."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼ確実に同じファイルが 2 つあります。"
          }
