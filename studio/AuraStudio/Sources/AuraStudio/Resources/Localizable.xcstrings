          "stringUnit": {
            "state": "translated",
            "value": "The language is applied at startup. If you choose “Later”, it stays saved and applies the next time you open Aura Studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma se aplica al arrancar. Si eliges «Más tarde», queda guardado y se aplica la próxima vez que abras Aura Studio."
