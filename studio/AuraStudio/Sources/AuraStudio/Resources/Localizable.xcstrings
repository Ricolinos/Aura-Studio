    "enter-d-f-u-view.no-aparece-pausar-servicios-macos-que": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint nicht? Die macOS-Dienste anhalten, die stören können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not showing up? Pause the macOS services that can interfere"
