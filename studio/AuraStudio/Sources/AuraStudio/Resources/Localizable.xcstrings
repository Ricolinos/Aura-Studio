    "albums-view.aplica-sin-preguntar-caratula-que-supere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet Album für Album ohne Nachfrage das Cover an, das den Schwellenwert erreicht; die ohne sichere Option wählst du selbst, eines nach dem anderen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies the cover that passes the confidence threshold without asking, album by album; you pick the ones with no safe option yourself, one at a time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica sin preguntar la carátula que supere el umbral de confianza en cada álbum; los que no tengan una opción segura los eliges tú, uno por uno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique sans demander la pochette qui dépasse le seuil de confiance, album par album ; celles qui n’ont pas d’option sûre, vous les choisissez vous-même, une par une"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼度のしきい値を超えたアートワークを、アルバムごとに確認なしで適用します。確実な候補がないものはひとつずつご自分で選びます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяет без вопросов обложку, прошедшую порог уверенности, альбом за альбомом; те, где нет надёжного варианта, вы выбираете сами, по одному"
          }
        }
      }
    },
    "albums-view.aplica-sin-preguntar-solo-caratula-que": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet ohne Nachfrage nur das Cover an, das den Schwellenwert erreicht; wenn keines ihn erreicht, öffnet sich die Auswahl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only the cover that passes the confidence threshold without asking; if none does, the picker opens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica sin preguntar solo la carátula que supere el umbral de confianza; si ninguna lo supera, se abre el selector"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’applique sans demander que la pochette qui dépasse le seuil de confiance ; si aucune ne le dépasse, le sélecteur s’ouvre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼度のしきい値を超えたアートワークだけを確認なしで適用します。超えるものがない場合は選択画面が開きます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяет без вопросов только обложку, прошедшую порог уверенности; если ни одна не проходит, открывается выбор"
          }
        }
      }
    },
    "albums-view.aplicar-caratula-recomendada": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
