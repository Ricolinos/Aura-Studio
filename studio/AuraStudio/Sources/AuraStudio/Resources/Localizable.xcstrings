    "settings.language-note-new": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache wird beim Start der App angewendet. Die Namen deiner Fotosammlungen und die bereits gesicherten Kategorien werden nicht übersetzt: Das sind deine Daten, kein Text der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language is applied when the app starts. The names of your photo collections and the categories you already saved are not translated: they are your data, not the app’s text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma se aplica al arrancar la app. Los nombres de tus colecciones de fotos y las categorías que ya guardaste no se traducen: son datos tuyos, no texto de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue s’applique au démarrage de l’app. Les noms de vos collections de photos et les catégories déjà enregistrées ne sont pas traduits : ce sont vos données, pas le texte de l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語はアプリの起動時に適用されます。写真のコレクション名や、すでに保存したカテゴリは翻訳されません。アプリの文言ではなく、あなたのデータだからです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык применяется при запуске приложения. Названия ваших коллекций фото и уже сохранённые категории не переводятся: это ваши данные, а не текст приложения."
          }
        }
      }
    },
