    "device-general-view.esta-accion-no-se-puede-deshacer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone -- files deleted from the iPod can't be recovered. Your library on this Mac is not touched; you can sync again whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer -- los archivos borrados del iPod no se pueden recuperar. Tu biblioteca en esta Mac no se toca; puedes volver a sincronizar cuando quieras."
          }
        }
      }
    },
    "device-general-view.esta-version-aura-studio-trae-mas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Aura Studio comes with a newer %@ than the one on your iPod. Updating does not erase your music or your settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Aura Studio trae un %@ más nuevo que el instalado en tu iPod. Actualizar no borra tu música ni tus ajustes."
          }
        }
      }
    },
    "device-general-view.este-ipod-tiene-rockbox-que-no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPod has a Rockbox that isn't Aura: the Aura Studio library doesn't apply to this install. In the Installer section you can install Aura (no flashing -- only the .rockbox folder is replaced) or restore the original firmware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPod tiene un Rockbox que no es Aura: la biblioteca de Aura Studio no aplica a esta instalacion. En la seccion Instalador puedes instalar Aura (sin flashear -- solo se reemplaza la carpeta .rockbox) o restaurar el firmware original."
          }
        }
      }
    },
    "device-general-view.expulsar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar"
          }
        }
      }
    },
    "device-general-view.general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "device-general-view.hay-archivos-aura-disco-pero-no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are Aura files on the disk, but no evidence that Aura boots on this iPod: Apple's firmware is running and Aura never wrote its settings here. Install Aura from the Installer section (it flashes the boot loader over DFU and copies the files again) to turn the library on. If you already installed it, start the iPod with Aura once and connect it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay archivos de Aura en el disco, pero no hay evidencia de que Aura arranque en este iPod: está corriendo el firmware de Apple y Aura nunca escribió su configuración aquí. Instala Aura desde la sección Instalador (flashea el arranque por DFU y vuelve a copiar los archivos) para activar la biblioteca. Si ya lo instalaste, enciende el iPod con Aura una vez y vuelve a conectarlo."
          }
        }
      }
    },
    "device-general-view.instalar-actualizacion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install %@ update"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar actualización de %@"
          }
        }
      }
    },
