    "services-settings-view.cuando-cancion-le-falta-caratula-se": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt einem Titel das Cover, werden diese Dienste der Reihe nach abgefragt und das erste gefundene Bild verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a song is missing cover art, these services are tried in order and the first image that shows up is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando a una canción le falta carátula, se prueban estos servicios en orden y se usa la primera imagen que aparezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une pochette manque à un morceau, ces services sont interrogés dans l’ordre et la première image trouvée est utilisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲にアートワークがないとき、これらのサービスを順に試し、最初に見つかった画像を使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда у трека нет обложки, эти сервисы опрашиваются по порядку и берётся первое найденное изображение."
          }
        }
      }
    },
