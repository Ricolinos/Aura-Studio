    "media-section-view.este-archivo-cambio-ipod-fuera-aura": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei hat sich auf dem iPod außerhalb von Aura Studio geändert. Beim nächsten Synchronisieren kannst du wählen, ob du sie behältst oder durch die Version aus deiner Mediathek ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed on the iPod outside Aura Studio. The next time you sync you’ll be able to choose whether to keep it or replace it with the version in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo cambió en el iPod fuera de Aura Studio. La próxima vez que sincronices podrás elegir si lo conservas o lo reemplazas con la versión de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a changé sur l’iPod en dehors d’Aura Studio. À la prochaine synchronisation, vous pourrez choisir de le conserver ou de le remplacer par la version de votre bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは Aura Studio 以外で iPod 上で変更されました。次に同期するとき、そのまま残すかライブラリの内容で置き換えるかを選べます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл изменился на iPod вне Aura Studio. При следующей синхронизации вы сможете выбрать, оставить его или заменить версией из вашей медиатеки."
          }
        }
      }
    },
