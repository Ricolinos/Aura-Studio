    "settings-section-view.hoy-todas-versiones-publicadas-aura-stud": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit ist jede veröffentlichte Version von Aura Studio eine Beta, deshalb lohnt es sich, das aktiviert zu lassen. Aura Studio aktualisiert sich nie selbst: Es informiert dich nur und lässt dich das Installationsprogramm laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now every published version of Aura Studio is a beta, so it’s worth leaving this on. Aura Studio never updates itself: it only tells you and lets you download the installer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy todas las versiones publicadas de Aura Studio son beta, así que conviene dejarlo activado. Aura Studio nunca se actualiza sola: solo te avisa y te deja bajar el instalador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, toutes les versions publiées d’Aura Studio sont des bêtas, il vaut donc mieux laisser cette option activée. Aura Studio ne se met jamais à jour tout seul : il vous prévient et vous laisse télécharger le programme d’installation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、公開されている Aura Studio はすべてベータ版なので、オンのままにしておくことをおすすめします。Aura Studio が自分で更新することはありません。お知らせして、インストーラーをダウンロードできるようにするだけです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас все опубликованные версии Aura Studio — бета, поэтому этот параметр лучше оставить включённым. Aura Studio никогда не обновляется сама: она лишь сообщает вам и даёт скачать установщик."
          }
        }
      }
    },
