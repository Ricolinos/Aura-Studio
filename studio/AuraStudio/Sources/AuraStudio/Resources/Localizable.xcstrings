      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the iPod"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPod"
          }
        }
      }
    },
    "device-general-view.mientras-tanto-puedes-ir-armando-bibliot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the meantime you can start building your library in Music, Video and Photos: it syncs when you connect the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras tanto puedes ir armando la biblioteca en Musica, Video y Fotos: se sincroniza cuando conectes el dispositivo."
          }
        }
      }
    },
    "device-general-view.musica-este-ipod-administra-firmware-ori": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music on this iPod is managed by Apple's original firmware -- it syncs with Finder (or the Music app), not with Aura Studio. If you install Aura from the Installer section, the Aura Studio library turns on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica de este iPod la administra el firmware original de Apple -- se sincroniza con Finder (o la app Musica), no con Aura Studio. Si instalas Aura desde la seccion Instalador, la biblioteca de Aura Studio se activa."
          }
        }
      }
    },
