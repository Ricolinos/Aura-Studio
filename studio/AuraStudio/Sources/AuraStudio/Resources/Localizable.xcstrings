          "stringUnit": {
            "state": "translated",
            "value": "Album %@ of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbum %@ de %@"
          }
        }
      }
    },
    "album-cover-picker-view.buscando-caratulas-cover-art-archive-dee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching Cover Art Archive and Deezer for cover art..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando carátulas en Cover Art Archive y Deezer..."
