          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте их только если вам не хватает обложек: перечисленные выше уже покрывают обычный случай."
          }
        }
      }
    },
    "services-settings-view.se-investigaron-no-se-van-integrar": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese wurden geprüft und werden NICHT eingebunden. Festgehalten, damit sie nicht noch einmal bewertet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These were looked into and will NOT be integrated. Written down so they don’t get evaluated again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se investigaron y NO se van a integrar. Queda escrito para no volver a evaluarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceux-ci ont été étudiés et ne seront PAS intégrés. Noté ici pour ne pas les réévaluer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検討しましたが、組み込みません。再度検討しないよう記録しています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их изучили и НЕ будут подключать. Записано, чтобы не оценивать их снова."
          }
        }
      }
    },
