    "done-view.para-volver-apple-cualquier-momento-mant": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jederzeit zu Apple zurückzukehren, halte beim Einschalten des iPods etwa 5 Sekunden SELECT + MENU gedrückt. Jede andere Kombination (oder keine) startet %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To go back to Apple at any time, hold SELECT + MENU for about 5 seconds while turning the iPod on. Any other combination (or none) starts %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para volver a Apple en cualquier momento, mantén SELECT + MENU presionados unos 5 segundos al encender el iPod. Cualquier otra combinacion (o nada) arranca %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour revenir à Apple à tout moment, maintenez SELECT + MENU environ 5 secondes en allumant l’iPod. Toute autre combinaison (ou aucune) démarre %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも Apple に戻すには、iPod の電源を入れながら SELECT + MENU を約 5 秒間押し続けてください。それ以外の組み合わせ（または何も押さない場合）は %@ が起動します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы в любой момент вернуться к Apple, удерживайте SELECT + MENU около 5 секунд при включении iPod. Любое другое сочетание (или ни одного) запускает %@."
          }
        }
      }
    },
