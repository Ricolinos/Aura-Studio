    "similar-items.confianza.posible-detalle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ähneln sich, könnten aber verschiedene Fassungen sein. Ein Blick lohnt sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They look alike, but they could be different versions. Worth a look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se parecen, pero podrían ser versiones distintas. Conviene revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils se ressemblent, mais ce sont peut-être des versions différentes. Mieux vaut vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似ていますが、別のバージョンかもしれません。確認をおすすめします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они похожи, но это могут быть разные версии. Стоит проверить."
          }
        }
      }
    },
