    "media-info-view.nombre-destino-ipod-se-arma-con": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination name on the iPod is built from these three fields -- changing them and syncing again regroups the episode in Movie Flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de destino en el iPod se arma con estos tres campos -- cambiarlos y sincronizar de nuevo reagrupa el episodio en Movie Flow."
          }
        }
      }
    },
    "media-info-view.se-guarda-junto-cancion-se-muestra": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved next to the song and shown on screen while it plays on the iPod."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda junto a la canción y se muestra en pantalla mientras suena en el iPod."
          }
        }
      }
    },
    "media-info-view.se-sincroniza-con-ipod-misma-calificacio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs with the iPod: the same rating you pick here or in the device's “Now Playing”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con el iPod: la misma calificación que se elige acá o en \"Ahora suena\" del aparato."
          }
        }
      }
    },
    "media-info-view.titulo-artista-album-son-obligatorios-pa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title, artist and album are required to sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista y álbum son obligatorios para sincronizar."
          }
        }
      }
    },
    "media-section-view.aura-studio-ahora-lee-mejor-etiquetas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio now reads the tags in your files better. Do you want to read the %lld song(s) in your library again?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio ahora lee mejor las etiquetas de tus archivos. ¿Quieres volver a leer las %lld canción(es) de tu biblioteca?"
          }
        }
      }
    },
    "media-section-view.busca-poster-tmdb-fanart-tv-necesita": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks the poster up on TMDB and fanart.tv (needs the TMDB API key in Settings › Services) and copies it next to the video on the iPod"
          }
        },
        "es": {
