      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language is applied when the app starts. The names of your photo collections and the categories you already saved are not translated: they are your data, not the app's text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma se aplica al arrancar la app. Los nombres de tus colecciones de fotos y las categorías que ya guardaste no se traducen: son datos tuyos, no texto de la app."
          }
        }
      }
