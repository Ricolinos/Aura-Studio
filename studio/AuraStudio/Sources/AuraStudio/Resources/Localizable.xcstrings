    "settings.cover-art-album-only-detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einziges Bild wird im Albumordner gesichert und von allen Titeln geteilt. Braucht weniger Platz, und die Firmware sucht zuerst danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single image is stored in the album folder and shared by all its songs. Uses less space, and it is what the firmware looks for first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda una sola imagen en la carpeta del album y todas sus canciones la comparten. Ocupa menos espacio y es lo que el firmware busca primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule image est enregistrée dans le dossier de l’album et partagée par tous ses morceaux. Prend moins de place, et c’est ce que le firmware cherche en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムのフォルダに画像を 1 枚だけ保存し、そのすべての曲で共有します。容量が少なくて済み、ファームウェアが最初に探す場所でもあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке альбома хранится одно изображение, общее для всех его треков. Занимает меньше места, и прошивка ищет именно его в первую очередь."
          }
        }
      }
    },
    "settings.cover-art-per-track": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eins pro Titel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per song"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una por cancion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une par morceau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲ごとに 1 枚"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна на трек"
          }
        }
      }
    },
    "settings.cover-art-per-track-detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Titel trägt sein eigenes Cover in der Datei. Nützlich für Singles und Sampler, wo ein Cover pro Album falsch wäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each song carries its own cover embedded in the file. Useful for singles and compilations, where one cover per album would be wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cancion lleva su propia caratula embebida en el archivo. Util para singles y recopilaciones, donde una unica portada por album seria incorrecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque morceau porte sa propre pochette intégrée au fichier. Utile pour les singles et les compilations, où une seule pochette par album serait fausse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各曲がファイルに埋め込まれた独自のアートワークを持ちます。アルバムごとに 1 枚では正しくないシングルやコンピレーションに向いています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый трек несёт свою обложку внутри файла. Полезно для синглов и сборников, где одна обложка на альбом была бы неверной."
          }
        }
      }
    },
    "settings.enrich-online": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten online vervollständigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete metadata online"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completar metadata en linea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compléter les métadonnées en ligne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータをオンラインで補完"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнять метаданные из сети"
          }
        }
      }
    },
    "settings.enrich-online-detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Interpret, Album, Jahr und Cover, wenn sie in der Datei fehlen. Schalte es aus, um nur zu verwenden, was die Datei schon hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills in artist, album, year and cover art when the file lacks them. Turn it off to use only what the file already has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena artista, album, ano y caratula cuando el archivo no los trae. Si lo apagas, solo se usa lo que ya tiene el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complète l’artiste, l’album, l’année et la pochette quand ils manquent au fichier. Désactivez-la pour n’utiliser que ce que le fichier contient déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにアーティスト、アルバム、年、アートワークがないときに補います。オフにすると、ファイルにある情報だけを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняет исполнителя, альбом, год и обложку, когда их нет в файле. Выключите, чтобы использовать только то, что уже есть в файле."
          }
        }
      }
    },
