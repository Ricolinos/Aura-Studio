    "sync-sheets.aura-studio-nunca-escribio-estos-archivo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio hat diese Dateien nie geschrieben – sie gehören nicht zu deiner Mediathek. Du kannst sie importieren (sie werden auf deinen Mac kopiert und Teil deiner Mediathek) oder vom iPod löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio never wrote these files -- they’re not part of your library. You can import them (they get copied to your Mac and become part of your library) or delete them from the iPod."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio nunca escribió estos archivos -- no forman parte de tu biblioteca. Puedes importarlos (se copian a tu Mac y pasan a ser parte de tu biblioteca) o eliminarlos del iPod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio n’a jamais écrit ces fichiers — ils ne font pas partie de votre bibliothèque. Vous pouvez les importer (ils sont copiés sur votre Mac et rejoignent votre bibliothèque) ou les supprimer de l’iPod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルは Aura Studio が書き込んだものではなく、ライブラリの一部でもありません。読み込む（Mac にコピーされ、ライブラリの一部になります）か、iPod から削除できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Studio никогда не записывала эти файлы — они не входят в вашу медиатеку. Их можно импортировать (они скопируются на ваш Mac и войдут в медиатеку) или удалить с iPod."
          }
        }
      }
    },
