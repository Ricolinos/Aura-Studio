    "detect-device-view.conecta-tu-ipod-classic-6g-este": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließ deinen iPod Classic 6G per USB an diesen Mac an. Wenn iTunes/Musik von selbst aufgeht, kannst du es schließen – es stört Aura Studio nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your iPod Classic 6G to this Mac over USB. If iTunes/Music opens on its own, you can close it -- it doesn’t interfere with Aura Studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu iPod Classic 6G a este Mac por USB. Si iTunes/Music se abre solo, puedes cerrarlo -- no interfiere con Aura Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez votre iPod Classic 6G à ce Mac en USB. Si iTunes/Musique s’ouvre tout seul, vous pouvez le fermer — il n’interfère pas avec Aura Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod Classic 6G を USB でこの Mac に接続してください。iTunes／ミュージックが自動で開いた場合は閉じてかまいません。Aura Studio の邪魔にはなりません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите iPod Classic 6G к этому Mac по USB. Если iTunes/Музыка откроется сама, её можно закрыть — она не мешает Aura Studio."
          }
        }
      }
    },
    "detect-device-view.encontramos-con-firmware-original-apple": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben „%@“ gefunden, mit Apples Original-Firmware (noch nicht auf FAT32). Du musst nichts umwandeln: Klick auf „Ist angeschlossen, trotzdem fortfahren“ und Aura Studio formatiert ihn später automatisch, beim Vorbereiten der Festplatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found “%@”, with Apple’s original firmware (not on FAT32 yet). You don’t need to convert it: click “I connected it, continue anyway” and Aura Studio will format it automatically later, in the disk preparation step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos \"%@\", con el firmware original de Apple (no esta en FAT32 todavia). No hace falta que lo conviertas: haz clic en \"Ya lo conecte, continuar igual\" y Aura Studio lo formatea automaticamente en el paso de preparar el disco, mas adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé « %@ », avec le firmware d’origine d’Apple (pas encore en FAT32). Inutile de le convertir : cliquez sur « Il est branché, continuer quand même » et Aura Studio le formatera automatiquement plus tard, à l’étape de préparation du disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 純正ファームウェアの「%@」が見つかりました（まだ FAT32 ではありません）。変換の必要はありません。「接続しました。このまま続ける」をクリックすれば、あとのディスク準備の段階で Aura Studio が自動的にフォーマットします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли «%@» с оригинальной прошивкой Apple (пока не в FAT32). Преобразовывать ничего не нужно: нажмите «Подключил, всё равно продолжить», и Aura Studio отформатирует его автоматически позже, на шаге подготовки диска."
          }
        }
      }
    },
    "detect-device-view.encontramos-dispositivo-apple-pero-no-pu": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben ein Apple-Gerät gefunden, konnten aber nicht bestätigen, dass es ein iPod Classic 6G ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found an Apple device, but we couldn’t confirm it is an iPod Classic 6G."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos un dispositivo Apple, pero no pudimos confirmar que sea un iPod Classic 6G."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé un appareil Apple, mais nous n’avons pas pu confirmer qu’il s’agit d’un iPod Classic 6G."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple のデバイスが見つかりましたが、iPod Classic 6G であることは確認できませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли устройство Apple, но не смогли подтвердить, что это iPod Classic 6G."
          }
        }
      }
    },
    "detect-device-view.encontramos-preparando-siguiente-paso": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben „%@“ gefunden. Der nächste Schritt wird vorbereitet …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found “%@”. Getting the next step ready…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos \"%@\". Preparando el siguiente paso..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé « %@ ». Préparation de l’étape suivante…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が見つかりました。次の手順を準備しています…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли «%@». Готовим следующий шаг…"
          }
        }
      }
    },
    "detect-device-view.encontramos-tu-ipod-pero-su-disco": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen iPod gefunden, aber seine Festplatte hat kein lesbares Dateisystem (so sieht sie im Bootloader-Modus aus, oder wenn eine Installation abgebrochen wurde). Klick auf „Ist angeschlossen, trotzdem fortfahren“, um ihn vorzubereiten und Aura zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found your iPod, but its disk has no readable file system (that’s how it looks in boot loader mode, or if an install was left halfway). Click “I connected it, continue anyway” to prepare it and install Aura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos tu iPod, pero su disco no tiene un sistema de archivos legible (asi se ve en el modo bootloader, o si una instalacion quedo a medias). Haz clic en \"Ya lo conecte, continuar igual\" para prepararlo e instalar Aura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé votre iPod, mais son disque n’a pas de système de fichiers lisible (c’est l’aspect qu’il a en mode bootloader, ou si une installation s’est arrêtée en cours). Cliquez sur « Il est branché, continuer quand même » pour le préparer et installer Aura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPod は見つかりましたが、ディスクに読み取れるファイルシステムがありません（ブートローダーモードのとき、またはインストールが途中で終わったときにこうなります）。「接続しました。このまま続ける」をクリックして、準備と Aura のインストールを行ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли ваш iPod, но на его диске нет читаемой файловой системы (так он выглядит в режиме загрузчика или если установка прервалась). Нажмите «Подключил, всё равно продолжить», чтобы подготовить его и установить Aura."
          }
        }
      }
    },
    "detect-device-view.tu-ipod-ya-esta-modo-dfu": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
