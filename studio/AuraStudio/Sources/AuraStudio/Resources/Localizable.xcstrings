    "batch-media-info-view.se-editan-cancion-usa-cambiar-nombre": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese werden einzeln bearbeitet – nimm „Umbenennen …“ oder „Weitere Informationen …“ bei einem einzelnen Objekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are edited one song at a time -- use “Rename…” or “More information…” on a single item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se editan de a una canción -- usa \"Cambiar nombre...\" o \"Más información...\" sobre un solo elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils se modifient un morceau à la fois — utilisez « Renommer… » ou « Plus d’informations… » sur un seul élément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは 1 曲ずつ編集します。項目をひとつ選んで「名称変更…」または「詳細情報…」をお使いください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они меняются по одному треку — используйте «Переименовать…» или «Подробнее…» для одного объекта."
          }
        }
      }
    },
    "batch-media-info-view.vas-editar-canciones-vez-campos-que": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bearbeitest gleich %lld Titel auf einmal. Felder, die nicht bei allen übereinstimmen, stehen als „Gemischt“ – was du eingibst, gilt für alle %lld. Titel und Titelnummer lassen sich nicht als Stapel bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to edit %lld songs at once. Fields that don’t match across all of them show as “Mixed” -- whatever you type applies to all %lld. Title and track number can’t be edited in bulk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas a editar %lld canciones a la vez. Los campos que no coincidan entre todas se muestran como \"Mixto\" -- lo que escribas se aplica a las %lld. El título y el número de pista no se pueden editar en lote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez modifier %lld morceaux d’un coup. Les champs qui diffèrent d’un morceau à l’autre s’affichent comme « Mixte » — ce que vous saisissez s’applique aux %lld. Le titre et le numéro de piste ne se modifient pas par lot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 曲をまとめて編集します。すべてで一致しない項目は「混在」と表示され、入力した内容は %lld 曲すべてに適用されます。タイトルとトラック番号は一括編集できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы измените сразу %lld треков. Поля, которые различаются, показаны как «Разное» — то, что вы введёте, применится ко всем %lld. Название и номер трека нельзя менять пакетно."
          }
        }
      }
    },
