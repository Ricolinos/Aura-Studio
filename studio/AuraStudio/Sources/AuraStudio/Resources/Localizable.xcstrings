    "licenses-view.todos-firmwares-su-bootloader-dual-boot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Firmwares, ihr Dual-Boot-Bootloader und das Flash-Werkzeug mks5lboot stammen vom Rockbox-Projekt (GPL v2). Aura Studio verändert keine dieser Binärdateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the firmwares, their dual-boot boot loader and the mks5lboot flashing tool derive from the Rockbox project (GPL v2). Aura Studio does not modify any of those binaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los firmwares, su bootloader dual-boot y la herramienta de flasheo mks5lboot derivan del proyecto Rockbox (GPL v2). Aura Studio no modifica ninguno de esos binarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les firmwares, leur bootloader dual-boot et l’outil de flashage mks5lboot dérivent du projet Rockbox (GPL v2). Aura Studio ne modifie aucun de ces binaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのファームウェア、そのデュアルブート用ブートローダー、書き込みツール mks5lboot は Rockbox プロジェクト（GPL v2）に由来します。Aura Studio はこれらのバイナリを一切変更していません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все прошивки, их загрузчик двойной загрузки и инструмент прошивки mks5lboot происходят из проекта Rockbox (GPL v2). Aura Studio не изменяет ни один из этих двоичных файлов."
          }
        }
      }
    },
