    "music-settings-view.nombres-que-no-se-deben-recortar": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, die nicht gekürzt werden dürfen, auch wenn sie ein Trennzeichen enthalten, etwa „Simon + Garfunkel“ oder „Café con Leche“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names that must not be trimmed even if they contain a separator, like “Simon + Garfunkel” or “Café con Leche”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres que no se deben recortar aunque traigan un separador, como «Simon + Garfunkel» o «Café con Leche»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms à ne pas couper même s’ils contiennent un séparateur, comme « Simon + Garfunkel » ou « Café con Leche »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り文字が含まれていても切り詰めてはいけない名前です。たとえば「Simon + Garfunkel」や「Café con Leche」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, которые нельзя обрезать, даже если в них есть разделитель, например «Simon + Garfunkel» или «Café con Leche»."
          }
        }
      }
    },
