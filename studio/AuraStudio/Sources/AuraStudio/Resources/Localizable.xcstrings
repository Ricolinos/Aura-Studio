        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm diese nur dazu, wenn dir Cover fehlen: Die oben decken den Normalfall schon ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add these only if you are missing cover art: the ones above already cover the normal case."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agregan solo si te faltan caratulas: lo de arriba ya cubre el caso normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ajouter seulement s’il vous manque des pochettes : ceux du dessus couvrent déjà le cas normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
