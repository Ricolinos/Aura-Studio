      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses typefaces or symbols with a restricted license (for example, SF Pro or SF Symbols)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tipografías o símbolos con licencia restringida (por ejemplo, SF Pro o SF Symbols)"
          }
        }
      }
    },
    "video-settings-view.formato-video": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video format"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de video"
          }
        }
      }
    },
    "video-settings-view.organizar-por-categoria-biblioteca": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize by category in the library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizar por categoría en la biblioteca"
          }
        }
      }
    },
    "video-settings-view.separa-tus-videos-videos-series-pelicula": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits your videos into Videos, Series and Movies so they're easier to find INSIDE Aura Studio (the category is suggested by duration on import -- except “Series”, which has no reliable heuristic and is always assigned by hand -- and you can correct it in Library → Video). It doesn't change where they end up on the iPod: there they are always copied together into “Videos”, because the iPod's player doesn't browse subfolders yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa tus videos en Videos, Series y Películas para encontrarlos más fácil DENTRO de Aura Studio (la categoría se sugiere sola por duración al importar -- salvo \"Series\", que no tiene una heurística confiable y siempre se asigna a mano -- y se puede corregir en Biblioteca → Video). No cambia dónde quedan en el iPod: ahí siempre se copian juntos en \"Videos\", porque el reproductor del iPod todavía no navega por subcarpetas."
          }
        }
      }
    },
    "video-settings-view.todo-video-se-convierte-320x240-mpeg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every video is converted to 320x240 MPEG-1/2 when syncing -- it's the only format an iPod with Aura can play at full speed (this iPod's chip can't decode H.264 or modern formats). It isn't a preference: it's a real limitation of 2007 hardware, so there's nothing to choose here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo video se convierte a 320x240 MPEG-1/2 al sincronizar -- es el único formato que el iPod con Aura puede reproducir a velocidad completa (el chip de este iPod no puede decodificar H.264 ni formatos modernos). No es una preferencia: es una limitación real del hardware de 2007, así que aquí no hay nada que elegir."
          }
        }
      }
    },
    "welcome-view.entiendo-que-arranque-apple-se-borra": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that Apple's boot loader is erased"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que el arranque de Apple se borra"
          }
        }
      }
    },
    "welcome-view.firmware-original-apple-se-borra-arranqu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's original firmware is erased from the iPod's boot loader. Once installed, the iPod only starts %@; to go back to Apple you have to restore it from scratch with iTunes/Finder. (Dual boot needs an iPod in “winpod” format -- restored from Windows -- and an iPod restored from a Mac isn't one, so Aura Studio no longer offers it.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware original de Apple se borra del arranque del iPod. Una vez instalado, el iPod solo arranca %@; para volver a Apple hay que restaurarlo con iTunes/Finder desde cero. (El dual boot necesita un iPod en formato \"winpod\" -- restaurado desde Windows --, y un iPod restaurado desde Mac no lo es, asi que Aura Studio ya no lo ofrece.)"
          }
        }
      }
    },
    "welcome-view.marca-casilla-arriba-para-continuar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the box above to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la casilla de arriba para continuar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
