    "extras-view.estos-extras-ipod-original-no-estan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Extras des Original-iPods sind in Aura nicht umgesetzt. Sobald es sie gibt, lassen sie sich von hier aus verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These extras from the original iPod are not implemented in Aura. When they exist, you’ll be able to manage them from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos extras del iPod original no estan implementados en Aura. Cuando existan, se van a poder gestionar desde aca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces extras de l’iPod d’origine ne sont pas implémentés dans Aura. Quand ils existeront, ils se géreront d’ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純正 iPod のこれらの機能は Aura には実装されていません。実装されたら、ここから管理できるようになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти дополнения оригинального iPod в Aura не реализованы. Когда они появятся, управлять ими можно будет отсюда."
          }
        }
      }
    },
