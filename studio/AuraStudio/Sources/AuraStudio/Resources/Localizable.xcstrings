    },
    "albums-view.busca-varias-caratulas-cover-art-archive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht in Cover Art Archive und Deezer nach mehreren Covern und wendet das von dir gewählte auf alle Titel des Albums an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches Cover Art Archive and Deezer for several covers and applies the one you pick to every song on the album"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca varias carátulas en Cover Art Archive y Deezer y aplica la que elijas a todas las canciones del álbum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche plusieurs pochettes sur Cover Art Archive et Deezer et applique celle que vous choisissez à tous les morceaux de l’album"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover Art Archive と Deezer で複数のアートワークを探し、選んだものをアルバムの全曲に適用します"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет несколько обложек в Cover Art Archive и Deezer и применяет выбранную вами ко всем трекам альбома"
          }
        }
      }
    },
