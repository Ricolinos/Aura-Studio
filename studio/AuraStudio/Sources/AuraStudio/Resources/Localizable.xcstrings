    "album-cover-picker-view.revisa-que-titulo-artista-album-esten": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüf, ob Albumtitel und Interpret richtig geschrieben sind; du kannst auch Deezer unter Einstellungen › Dienste aktivieren, um mehr Treffer zu bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the album title and artist are spelled correctly; you can also turn on Deezer in Settings › Services to get more results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa que el título y el artista del álbum estén bien escritos; también puedes activar Deezer en Ajustes › Servicios para tener más resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le titre de l’album et l’artiste sont bien orthographiés ; vous pouvez aussi activer Deezer dans Réglages › Services pour obtenir plus de résultats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム名とアーティスト名のつづりをご確認ください。設定 › サービスで Deezer を有効にすると、より多くの候補が見つかります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, правильно ли написаны название альбома и исполнитель; можно также включить Deezer в разделе Настройки › Сервисы, чтобы получить больше результатов."
          }
        }
      }
    },
    "album-cover-picker-view.usar-esta-caratula": {
