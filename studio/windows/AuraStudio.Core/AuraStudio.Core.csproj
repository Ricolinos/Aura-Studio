<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuraStudio.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lectura de etiquetas (ID3v2.3/2.4, Vorbis de FLAC, átomos MP4 y
         carátulas embebidas). En macOS ese trabajo lo hace AVFoundation, que no
         existe acá; TagLib# es lo que cubre los mismos contenedores con una
         sola API. Es LGPL y se enlaza dinámicamente (paquete NuGet), compatible
         con una app cerrada; se declara en la pantalla de Licencias.
         Las REGLAS de mapeo de campos se portan aparte, en TrackTagRules, para
         que el resultado coincida con el de macOS y se pueda verificar. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- ST-247: los textos de cara al usuario. Viven en Core y no en la app
         porque Core también los produce —el resumen de lo que se arrastró, el
         conteo de álbumes, la barra de estado— y no puede referenciar a la app.
         Dejarlos allá habría condenado esas pantallas a un solo idioma.

         Español como cultura NEUTRA, o sea compilado dentro del ensamblado: si
         mañana falta el satélite de otro idioma, la app cae en español y nunca
         en blanco. `.resx` y no `.resw` con el sistema de recursos de WinUI:
         ver Resources\Strings.cs para el motivo completo. -->
    <EmbeddedResource Update="Strings\Resources.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.resources</LogicalName>
    </EmbeddedResource>

    <!-- Cada idioma más va en su satélite: <cultura>\AuraStudio.Core.resources.dll.
         El nombre lógico se escribe, aunque sin escribirlo también funcione: el
         SDK incluye los .resx por su cuenta e infiere la cultura del nombre, y
         el nombre lógico que le toca por convención resulta ser el mismo que
         busca el ResourceManager. Eso es una coincidencia, no un acuerdo, y su
         modo de falla es el peor: si algún día deja de coincidir, la app pide
         un idioma, no lo encuentra y cae al español SIN fallar nada. Escrito,
         el emparejamiento con el neutro está a la vista; y una prueba
         (ResourceProjectTests) exige que cada .resx de esta carpeta tenga su
         entrada, para que no vuelva a perderse sin que nadie lo note. -->
    <EmbeddedResource Update="Strings\Resources.en.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.en.resources</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Update="Strings\Resources.de.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.de.resources</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Update="Strings\Resources.fr.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.fr.resources</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Update="Strings\Resources.ru.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.ru.resources</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Update="Strings\Resources.ja.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.ja.resources</LogicalName>
    </EmbeddedResource>

    <!-- SatelliteResourceLanguages NO se usa, y no por olvido: se probó.
         Declarando solo "de" —una cultura que no existía acá— el satélite en/
         se siguió generando, también tras borrar obj/ y bin/. Esa propiedad
         filtra los satélites que traen los paquetes NuGet, no los que el propio
         proyecto compila desde sus .resx. Dejarla puesta daría la impresión de
         controlar algo que no controla. Lo que sí controla qué idiomas tienen
         que existir es AppLanguages.RequiredSatelliteCultures, contra la que se
         comprueban el publish y el instalador. -->
  </ItemGroup>

</Project>
