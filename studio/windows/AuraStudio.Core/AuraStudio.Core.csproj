<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuraStudio.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lectura de etiquetas (ID3v2.3/2.4, Vorbis de FLAC, átomos MP4 y
         carátulas embebidas). En macOS ese trabajo lo hace AVFoundation, que no
         existe acá; TagLib# es lo que cubre los mismos contenedores con una
         sola API. Es LGPL y se enlaza dinámicamente (paquete NuGet), compatible
         con una app cerrada; se declara en la pantalla de Licencias.
         Las REGLAS de mapeo de campos se portan aparte, en TrackTagRules, para
         que el resultado coincida con el de macOS y se pueda verificar. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- ST-247: los textos de cara al usuario. Viven en Core y no en la app
         porque Core también los produce —el resumen de lo que se arrastró, el
         conteo de álbumes, la barra de estado— y no puede referenciar a la app.
         Dejarlos allá habría condenado esas pantallas a un solo idioma.

         Español como cultura NEUTRA, o sea compilado dentro del ensamblado: si
         mañana falta el satélite de otro idioma, la app cae en español y nunca
         en blanco. `.resx` y no `.resw` con el sistema de recursos de WinUI:
         ver Resources\Strings.cs para el motivo completo. -->
    <EmbeddedResource Update="Strings\Resources.resx">
      <LogicalName>AuraStudio.Core.Strings.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
