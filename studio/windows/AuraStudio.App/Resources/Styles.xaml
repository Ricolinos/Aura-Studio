<!--
    Tokens semánticos, tipografía, espaciado y estilos compartidos.

    Regla dura (principio 6 del plan, `docs/ARQUITECTURA.md`): **este es el
    único archivo XAML donde puede aparecer un color**. Toda página consume
    `ThemeResource` del sistema o los tokens de marca de `AuraPalette.xaml`.
    Un `Color`/`SolidColorBrush` literal fuera de acá es un bug, no un atajo.

    El acento de los controles es el del SISTEMA (`AccentFillColorDefaultBrush`
    y familia): Fluent 2 respeta el color de acento que el usuario eligió en
    Windows. La app de macOS tiñe todo con el acento de marca porque en macOS
    ese es el idioma de la plataforma; acá no. El acento de marca queda
    disponible como `AuraBrandAccentBrush` para los momentos de identidad.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Resources/AuraPalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================= Espaciado =================
         Escala de 4 px, la de Fluent 2. Las páginas usan estos tokens en vez
         de números sueltos para que los márgenes concuerden entre pantallas. -->
    <x:Double x:Key="AuraSpacingXS">4</x:Double>
    <x:Double x:Key="AuraSpacingS">8</x:Double>
    <x:Double x:Key="AuraSpacingM">12</x:Double>
    <x:Double x:Key="AuraSpacingL">16</x:Double>
    <x:Double x:Key="AuraSpacingXL">24</x:Double>
    <x:Double x:Key="AuraSpacingXXL">32</x:Double>

    <Thickness x:Key="AuraPageMargin">32,24,32,24</Thickness>
    <Thickness x:Key="AuraCardPadding">20</Thickness>
    <x:Double x:Key="AuraContentMaxWidth">820</x:Double>
    <CornerRadius x:Key="AuraCardCornerRadius">8</CornerRadius>

    <!-- ================= Tipografía =================
         Segoe UI Variable: `Display` para títulos (óptico grande), `Text` para
         cuerpo. El respaldo es Segoe UI, que existe desde Windows 10 — Segoe UI
         Variable solo viene con Windows 11 y `TargetPlatformMinVersion` de este
         proyecto es 10.0.19041. -->
    <FontFamily x:Key="AuraDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AuraTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="AuraPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AuraDisplayFontFamily}" />
    </Style>

    <Style x:Key="AuraSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AuraDisplayFontFamily}" />
    </Style>

    <Style x:Key="AuraSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AuraCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ================= Superficies ================= -->
    <Style x:Key="AuraCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AuraCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AuraCardPadding}" />
    </Style>

    <!-- Tarjeta de menor jerarquía: mensajes de estado, notas al pie. -->
    <Style x:Key="AuraSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource AuraCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ================= Botones =================
         Se apoya en el estilo de acento del sistema en vez de una plantilla
         propia: así hereda estados (hover, pressed, deshabilitado), contraste
         alto y el acento elegido por el usuario, sin un solo color literal. -->
    <Style x:Key="AuraPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />

</ResourceDictionary>
