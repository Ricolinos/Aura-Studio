<Page
    x:Class="AuraStudio.App.Views.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource AuraPageMargin}"
                    MaxWidth="{StaticResource AuraContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="16">

            <StackPanel>
                <TextBlock Text="{x:Bind res:AppStrings.LicensesTitle}"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="{x:Bind res:AppStrings.LicensesSubtitle}"
                           Style="{StaticResource AuraSecondaryTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource AuraCardStyle}">
                <TextBlock Text="{x:Bind ViewModel.Intro}"
                           Style="{StaticResource AuraSecondaryTextStyle}"
                           IsTextSelectionEnabled="True" />
            </Border>

            <TextBlock Text="{x:Bind res:AppStrings.LicensesFamiliesHeading}"
                       Style="{StaticResource AuraSectionTitleTextStyle}"
                       Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Families}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FamilyLicenseEntry">
                        <Border Style="{StaticResource AuraCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           Style="{StaticResource AuraSectionTitleTextStyle}" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind res:AppStrings.LicensesRepositoryLabel}"
                                               Style="{StaticResource AuraCaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind RepositoryUrl}"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind res:AppStrings.LicensesTagLabel}"
                                               Style="{StaticResource AuraCaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind ReleaseTagText}"
                                               IsTextSelectionEnabled="True" />
                                    <!-- Nunca se inventa un tag: si no se conoce, se dice y se
                                         explica cómo dejarlo registrado. -->
                                    <TextBlock Text="{x:Bind res:AppStrings.LicensesUnknownTagDetail}"
                                               Style="{StaticResource AuraCaptionTextStyle}"
                                               Visibility="{x:Bind TagIsKnown, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind ModificationsText}"
                                           Style="{StaticResource AuraCaptionTextStyle}" />
                                <TextBlock Text="{x:Bind ThirdPartyText}"
                                           Style="{StaticResource AuraCaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Bind ViewModel.ToolHeading}"
                       Style="{StaticResource AuraSectionTitleTextStyle}"
                       Margin="0,8,0,0" />

            <Border Style="{StaticResource AuraCardStyle}">
                <TextBlock Text="{x:Bind ViewModel.ToolProvenanceText, Mode=OneWay}"
                           Style="{StaticResource AuraSecondaryTextStyle}"
                           IsTextSelectionEnabled="True" />
            </Border>

            <TextBlock Text="{x:Bind res:AppStrings.LicensesLibrariesHeading}"
                       Style="{StaticResource AuraSectionTitleTextStyle}"
                       Margin="0,8,0,0" />

            <Border Style="{StaticResource AuraCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind res:AppStrings.LicensesLibrariesIntro}"
                               Style="{StaticResource AuraSecondaryTextStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind res:AppStrings.LicensesTagLibName}"
                                   FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind res:AppStrings.LicensesTagLibDetail}"
                                   Style="{StaticResource AuraCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind res:AppStrings.LicensesTagLibSource}"
                                   Style="{StaticResource AuraCaptionTextStyle}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
