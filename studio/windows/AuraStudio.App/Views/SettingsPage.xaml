<Page
    x:Class="AuraStudio.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels"
    xmlns:str="using:AuraStudio.Core.Resources">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,*">

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{x:Bind res:AppStrings.SettingsTitle}"
                       Style="{StaticResource AuraPageTitleTextStyle}" />
            <TextBlock Text="{x:Bind res:AppStrings.SettingsSubtitle}"
                       Style="{StaticResource AuraSecondaryTextStyle}" />
        </StackPanel>

        <!-- Las mismas seis pestañas que macOS -->
        <SelectorBar Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                     Margin="0,0,0,16">
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.general')}" Tag="general" IsSelected="True" />
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.biblioteca')}" Tag="library" />
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.musica')}" Tag="music" />
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.fotos')}" Tag="photos" />
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.video')}" Tag="video" />
            <SelectorBarItem Text="{x:Bind str:Strings.Get('settings-page.servicios')}" Tag="services" />
        </SelectorBar>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="{StaticResource AuraContentMaxWidth}" HorizontalAlignment="Left">

                <!-- ===================== General ===================== -->
                <StackPanel x:Name="GeneralPanel" Spacing="16">

                    <TextBlock Text="{x:Bind res:AppStrings.SettingsAppearance}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" />

                    <Border Style="{StaticResource AuraCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind res:AppStrings.SettingsTheme}" />
                                <TextBlock Text="{x:Bind res:AppStrings.SettingsThemeDetail}"
                                           Style="{StaticResource AuraCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOption">
                                        <TextBlock Text="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.idioma')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource AuraCardStyle}">
                        <TextBlock Text="{x:Bind res:AppStrings.SettingsLanguageDetail}"
                                   Style="{StaticResource AuraSecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{x:Bind res:AppStrings.SettingsAbout}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />

                    <Border Style="{StaticResource AuraCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind res:AppStrings.AppName}"
                                           Style="{StaticResource AuraSectionTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                           Style="{StaticResource AuraSecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind res:AppStrings.LicensesSubtitle}"
                                           Style="{StaticResource AuraCaptionTextStyle}" />
                            </StackPanel>
                            <!-- Contrato §B: Licencias tiene que ser alcanzable. -->
                            <Button Grid.Column="1" Content="{x:Bind res:AppStrings.LicensesOpen}"
                                    Click="OpenLicenses_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ST-211: buscar una versión nueva de la app, donde ya se
                         habla de versiones. Siempre dice algo, incluso "ya
                         tienes la más nueva": preguntar y que no pase nada
                         visible es lo mismo que un botón roto. -->
                    <Border Style="{StaticResource AuraCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.Updates.StatusMessage, Mode=OneWay}"
                                           Style="{StaticResource AuraSecondaryTextStyle}"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Content="{x:Bind str:Strings.Get('settings-page.buscar-actualizaciones')}"
                                        Click="CheckAppUpdates_Click"
                                        IsEnabled="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                            </Grid>

                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <ProgressBar Maximum="1"
                                         Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Biblioteca ===================== -->
                <StackPanel x:Name="LibraryPanel" Spacing="16" Visibility="Collapsed">

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.carpeta-biblioteca')}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.aqui-vive-catalogo-biblioteca-funciona-a')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <Border Style="{StaticResource AuraCardStyle}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="{x:Bind ViewModel.LibraryPath, Mode=OneWay}"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.LibraryPath, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.abrir-explorador')}"
                                    Click="OpenLibraryFolder_Click" />
                            <Button Grid.Column="2" Content="{x:Bind str:Strings.Get('settings-page.cambiar')}" Click="ChangeLibraryFolder_Click" />
                        </Grid>
                    </Border>

                    <!-- Lo que pasa al cambiar de carpeta se dice ANTES, no después -->
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="{x:Bind str:Strings.Get('settings-page.cambiar-carpeta-mueve-nada')}"
                             Message="{x:Bind str:Strings.Get('settings-page.carpeta-nueva-biblioteca-anterior-intacta')}" />

                    <TextBlock Text="{x:Bind ViewModel.LibraryChangedNotice, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <!-- ST-245: texto compartido con la Mac (plan §2) — explica
                         los dos modos ANTES de que el usuario decida, no solo el
                         que está prendido ahora. -->
                    <TextBlock Text="{x:Bind ViewModel.StorageSectionTitle}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.StorageCopyExplainer}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StorageReferenceExplainer}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StorageChangeOnlyAffectsFuture}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap"
                               FontStyle="Italic" />

                    <ToggleSwitch Header="{x:Bind str:Strings.Get('settings-page.copiar-medios-carpeta-biblioteca')}"
                                  IsOn="{x:Bind ViewModel.CopyMediaIntoLibrary, Mode=TwoWay}"
                                  Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.CopyMediaDetail, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <!-- ST-243, corregido en ST-244: la conversión se avisa ANTES,
                         no después de que el usuario encuentre un .m4a donde
                         había dejado un .wav. El texto depende de la calidad
                         elegida, porque el resultado depende de ella. -->
                    <InfoBar IsOpen="{x:Bind ViewModel.CopyMediaIntoLibrary, Mode=OneWay}"
                             IsClosable="False" Severity="Informational"
                             Title="{x:Bind str:Strings.Get('settings-page.wav-aiff-siempre-se-convierten')}"
                             Message="{x:Bind ViewModel.AudioConversionDetail, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.archivos-huerfanos')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.OrphansDetail}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Button Content="{x:Bind ViewModel.OrphansScanButton}" Click="ScanOrphans_Click" />
                        <Button Grid.Column="1" Content="{x:Bind ViewModel.OrphansCleanButton}"
                                Click="CleanOrphans_Click"
                                IsEnabled="{x:Bind ViewModel.HasOrphansToClean, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.OrphanScanSummary, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasScannedForOrphans, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{x:Bind ViewModel.OrphanCleanupResult, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />


                    <!-- ST-246: la migración también vive acá, no solo en el
                         aviso. El aviso se apaga cuando ya no queda nada por
                         migrar, y hay un caso que no se puede detectar barato
                         al abrir —copias sin etiquetas escritas—: sin esta
                         entrada, ese caso no tendría por dónde arreglarse. -->
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.migrar-version-anterior')}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.MigrationDetail, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <Button Content="{x:Bind str:Strings.Get('settings-page.migrar-biblioteca')}"
                            Command="{x:Bind ViewModel.Library.MigrateLibraryCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.carpetas-vinculadas')}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.carpetas-externas-arrastraste-con-copia')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.todavia-vinculaste-ninguna-carpeta')}"
                               Style="{StaticResource AuraCaptionTextStyle}"
                               Visibility="{x:Bind ViewModel.HasLinkedFolders, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.LinkedFolders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource AuraSubtleCardStyle}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.quitar')}" Tag="{x:Bind}"
                                                Click="RemoveLinkedFolder_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.caratulas')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.caratula-por-album-recomendado')}"
                                 IsChecked="{x:Bind ViewModel.CoverArtAlbumOnly, Mode=TwoWay}"
                                 GroupName="coverArt" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.caratula-por-cancion')}"
                                 IsChecked="{x:Bind ViewModel.CoverArtPerTrack, Mode=TwoWay}"
                                 GroupName="coverArt" />
                    <TextBlock Text="{x:Bind ViewModel.CoverArtDetail, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.al-importar')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <CheckBox Content="{x:Bind str:Strings.Get('settings-page.completar-informacion-faltante-con-servi')}"
                              IsChecked="{x:Bind ViewModel.EnrichOnline, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.apagado-aura-studio-toca-red-al')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                    <CheckBox Content="{x:Bind str:Strings.Get('settings-page.buscar-letras-sincronizadas')}"
                              IsChecked="{x:Bind ViewModel.FetchSyncedLyrics, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanFetchLyrics, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.letras-vienen-lrclib-sin-clave-ni')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ===================== Música ===================== -->
                <StackPanel x:Name="MusicPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.carpetas-ipod')}" Style="{StaticResource AuraSectionTitleTextStyle}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.artista-album-recomendado')}" GroupName="musicOrg"
                                 IsChecked="{x:Bind ViewModel.MusicByArtistAlbum, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.solo-album')}" GroupName="musicOrg"
                                 IsChecked="{x:Bind ViewModel.MusicByAlbum, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.solo-artista')}" GroupName="musicOrg"
                                 IsChecked="{x:Bind ViewModel.MusicByArtist, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.MusicOrganizationDetail, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.nombre-archivo')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.solo-titulo-recomendado')}" GroupName="filename"
                                 IsChecked="{x:Bind ViewModel.FilenameTitleOnly, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.numero-pista-titulo')}" GroupName="filename"
                                 IsChecked="{x:Bind ViewModel.FilenameTrackTitle, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.titulo-artista')}" GroupName="filename"
                                 IsChecked="{x:Bind ViewModel.FilenameTitleArtist, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.titulo-album')}" GroupName="filename"
                                 IsChecked="{x:Bind ViewModel.FilenameTitleAlbum, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.FilenamePreview, Mode=OneWay}"
                               FontFamily="Consolas"
                               Style="{StaticResource AuraCaptionTextStyle}" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.calidad-audio')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.mantener-formato-original-recomendado')}" GroupName="audio"
                                 IsChecked="{x:Bind ViewModel.AudioOriginal, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.comprimir-mp3-buena-calidad')}" GroupName="audio"
                                 IsChecked="{x:Bind ViewModel.AudioCompressed, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.AudioQualityDetail, Mode=OneWay}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <!-- R2-4: agrupación de colaboraciones. Ver
                         docs/normalizacion-artistas.md. -->
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.colaboraciones')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <ToggleSwitch Header="{x:Bind str:Strings.Get('settings-page.agrupar-colaboraciones-bajo-artista-prin')}"
                                  IsOn="{x:Bind ViewModel.GroupCollaborations, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.GroupCollaborationsDetail}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.excepciones')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.nombres-grupo-llevan-uno-esos-separadore')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ArtistExceptionBox"
                                 PlaceholderText="{x:Bind str:Strings.Get('settings-page.nombre-completo-grupo')}"
                                 IsEnabled="{x:Bind ViewModel.GroupCollaborations, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.agregar')}" Click="AddArtistException_Click"
                                IsEnabled="{x:Bind ViewModel.GroupCollaborations, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.todavia-agregaste-ninguna-excepcion')}"
                               Style="{StaticResource AuraCaptionTextStyle}"
                               Visibility="{x:Bind ViewModel.HasArtistGroupingExceptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ArtistGroupingExceptions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource AuraSubtleCardStyle}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{x:Bind}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.quitar-2')}" Tag="{x:Bind}"
                                                Click="RemoveArtistException_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===================== Fotos ===================== -->
                <StackPanel x:Name="PhotosPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.calidad-imagen')}" Style="{StaticResource AuraSectionTitleTextStyle}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.optimizar-espacio-320-px-recomendado')}" GroupName="photoQuality"
                                 IsChecked="{x:Bind ViewModel.PhotoOptimized, Mode=TwoWay}" />
                    <RadioButton Content="{x:Bind str:Strings.Get('settings-page.version-hd-640-px')}" GroupName="photoQuality"
                                 IsChecked="{x:Bind ViewModel.PhotoHd, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.pantalla-ipod-es-320-240-foto')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <ToggleSwitch Header="{x:Bind str:Strings.Get('settings-page.organizar-por-coleccion-dentro-bibliotec')}"
                                  IsOn="{x:Bind ViewModel.OrganizePhotosByCategory, Mode=TwoWay}"
                                  Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.separa-tus-fotos-colecciones-para-encont')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.colecciones')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.los-nombres-que-escribes-no-se-traducen')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PhotoCollections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.quitar-3')}" Tag="{x:Bind}"
                                            Click="RemoveCollection_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NewCollectionBox" PlaceholderText="{x:Bind str:Strings.Get('settings-page.nueva-coleccion')}" />
                        <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('settings-page.agregar-2')}" Click="AddCollection_Click" />
                    </Grid>
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.quitar-coleccion-cambia-coleccion-fotos')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ===================== Video ===================== -->
                <StackPanel x:Name="VideoPanel" Spacing="10" Visibility="Collapsed">
                    <ToggleSwitch Header="{x:Bind str:Strings.Get('settings-page.organizar-por-categoria-dentro-bibliotec')}"
                                  IsOn="{x:Bind ViewModel.OrganizeVideosByCategory, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.separa-tus-videos-videos-series-pelicula')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.formato-video')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.todo-video-se-convierte-mpeg-1')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.ffmpeg')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.conversion-hace-ffmpeg-se-instala-aparte')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind str:Strings.Get('settings-page.elegir-ffmpeg-exe')}" Click="ChooseFfmpeg_Click" />
                        <Button Content="{x:Bind str:Strings.Get('settings-page.buscarlo-nuevo')}" Click="ClearFfmpeg_Click"
                                IsEnabled="{x:Bind ViewModel.HasManualFfmpegPath, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- ===================== Servicios ===================== -->
                <StackPanel x:Name="ServicesPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.activos-sin-configurar-nada')}" Style="{StaticResource AuraSectionTitleTextStyle}" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.musicbrainz-artista-album-ano-numero-pis')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.orden-busqueda-caratula')}"
                               Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.cuando-cancion-le-falta-caratula-se')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CoverProviders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoverProviderRow">
                                <Border Style="{StaticResource AuraSubtleCardStyle}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{x:Bind PositionText}" FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Reason}"
                                                       Style="{StaticResource AuraCaptionTextStyle}"
                                                       Visibility="{x:Bind HasReason, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind str:Strings.Get('settings-page.listo')}" VerticalAlignment="Center"
                                                   Style="{StaticResource AuraCaptionTextStyle}"
                                                   Visibility="{x:Bind Usable, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Grid.Column="3" Content="{x:Bind str:Strings.Get('settings-page.texto')}" Tag="{x:Bind Provider}"
                                                IsEnabled="{x:Bind CanMoveUp}"
                                                AutomationProperties.Name="Subir"
                                                Click="MoveProviderUp_Click" />
                                        <Button Grid.Column="4" Content="{x:Bind str:Strings.Get('settings-page.texto-2')}" Tag="{x:Bind Provider}"
                                                IsEnabled="{x:Bind CanMoveDown}"
                                                AutomationProperties.Name="Bajar"
                                                Click="MoveProviderDown_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleSwitch Header="{x:Bind str:Strings.Get('settings-page.deezer')}" IsOn="{x:Bind ViewModel.DeezerEnabled, Mode=TwoWay}"
                                  Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.caratula-alternativa-1000-1000-sin-clave')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.claves-tokens')}" Style="{StaticResource AuraSectionTitleTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{x:Bind str:Strings.Get('settings-page.se-guardan-administrador-credenciales-wi')}"
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <StackPanel x:Name="KeyRows" Spacing="10" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
