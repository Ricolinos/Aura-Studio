<Page
    x:Class="AuraStudio.App.Views.SimilarItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:vm="using:AuraStudio.App.ViewModels">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    </Page.Resources>

    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,Auto,*">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Elementos parecidos"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="Aura Studio busca canciones, fotos y videos que parezcan repetidos. No borra ni cambia nada por su cuenta: aquí ves por qué los juntó y decides tú."
                           Style="{StaticResource AuraSecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Buscar" Click="Scan_Click" VerticalAlignment="Center"
                    Style="{StaticResource AuraPrimaryButtonStyle}" />
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,12"
                     Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.LastMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                 Message="{x:Bind ViewModel.LastMessage, Mode=OneWay}"
                 Severity="Informational" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimilarGroupRow">
                        <Border Style="{StaticResource AuraCardStyle}" Margin="0,0,0,12" MaxWidth="820"
                                HorizontalAlignment="Left">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ConfidenceTitle}"
                                               Style="{StaticResource AuraSectionTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind ConfidenceDetail}"
                                               Style="{StaticResource AuraCaptionTextStyle}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Por qué se juntaron: la evidencia, no solo el veredicto -->
                                <TextBlock Text="{x:Bind Reasons}"
                                           Style="{StaticResource AuraCaptionTextStyle}"
                                           TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{x:Bind Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SimilarMember">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                                                  Margin="0,2,0,2">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Title}" />
                                                    <TextBlock Text="{x:Bind Path}"
                                                               Style="{StaticResource AuraCaptionTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind KeepLabel}"
                                                           Style="{StaticResource AuraCaptionTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind ShowsKeepLabel, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Grid.Column="2" Content="Conservar solo este"
                                                        Tag="{x:Bind Id}" Click="KeepOnly_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{x:Bind Suggestion}"
                                           Style="{StaticResource AuraCaptionTextStyle}"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Unificar la metadata" Tag="{x:Bind Id}"
                                            Click="ApplyEdits_Click"
                                            Visibility="{x:Bind HasEdits, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="No son lo mismo" Tag="{x:Bind Id}" Click="Ignore_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="12" MaxWidth="460"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                       Style="{StaticResource AuraSecondaryTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Volver a mostrar los descartados" Click="Restore_Click"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasIgnored, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>
