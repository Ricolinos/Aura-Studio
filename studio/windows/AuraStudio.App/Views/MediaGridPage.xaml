<Page
    x:Class="AuraStudio.App.Views.MediaGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:controls="using:AuraStudio.App.Controls"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </Page.Resources>

    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                           Style="{StaticResource AuraSecondaryTextStyle}"
                           TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Bind res:AppStrings.LibraryAddFiles}" Click="AddFiles_Click" />
                <Button Content="{x:Bind res:AppStrings.LibraryAddFolder}" Click="AddFolder_Click" />

                <Button Content="Buscar pósters" Click="VideoPosters_Click"
                        Visibility="{x:Bind ViewModel.ShowsVideoPosterAction, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{x:Bind ViewModel.Library.IsEnriching, Mode=OneWay, Converter={StaticResource InvertBool}}"
                        ToolTipService.ToolTip="Descarga los pósters que falten. Viajan pegados a su video en la próxima sincronización." />

            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.Library.LastDropMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                 Message="{x:Bind ViewModel.Library.LastDropMessage, Mode=OneWay}"
                 Severity="Informational"
                 Margin="0,0,0,12" />

        <!-- Un clic selecciona, dos abren (ST-103, y es lo que hace cualquier
             cuadrícula del sistema).

             ST-202: la selección la lleva el CONTROL. Con `Extended`, el
             GridView trae de fábrica clic, Ctrl+clic, Mayús+clic, Mayús+flechas
             y navegación con flechas — todo lo que antes estaba reimplementado
             a mano, y solo el clic simple lo estaba. La casilla sigue viviendo
             en la tarjeta (ST-103) y se sincroniza con `SelectedItems`.

             `IsItemClickEnabled` se fue con ella: con una selección de verdad,
             `ItemClick` se dispara ANTES de `SelectionChanged` y en algunos
             casos la selección ni siquiera llega a ocurrir. Abrir es doble clic,
             que es lo que era. -->
        <!-- ST-209: la capa que captura el arrastre va DETRÁS de las tarjetas, no
             encima. Arrastrar DESDE una tarjeta la mueve —eso es el arrastre de
             la tarjeta— y arrastrar desde un hueco dibuja el recuadro. Puesta de
             fondo, las tarjetas conservan sus clics y sus arrastres tal cual, y
             acá solo llega lo que empezó en un hueco.

             Addendum: con la ventana delante (W7) se comprobó que a esta capa
             **no le llega nada** — el `ScrollViewer` del `GridView` se queda con
             el puntero en toda su superficie, huecos incluidos. La capa se queda
             porque es la que define el gesto y porque no estorba; lo que
             garantiza que el arrastre exista son los manejadores que el
             code-behind engancha sobre la propia cuadrícula con
             `handledEventsToo`. Fondo transparente y no nulo a propósito: un
             fondo nulo la sacaría del árbol de hit-testing. -->
        <Border Grid.Row="2" x:Name="MarqueeCapture" Background="Transparent"
                PointerPressed="Marquee_PointerPressed"
                PointerMoved="Marquee_PointerMoved"
                PointerReleased="Marquee_PointerReleased"
                PointerCaptureLost="Marquee_PointerCaptureLost" />

        <GridView Grid.Row="2"
                  x:Name="CardsView"
                  ItemsSource="{x:Bind ViewModel.Cards}"
                  ContextRequested="Cards_ContextRequested"
                  Tapped="Cards_Tapped"
                  SelectionChanged="Cards_SelectionChanged"
                  SelectionMode="Extended">

            <!-- ST-202 (addendum): UNA sola marca de seleccionado.

                 Al pasar a `Extended`, el contenedor empezó a dibujar además la
                 marca del sistema —fondo, borde de 2 px y palomita— encima de la
                 que ya pone la tarjeta desde ST-103. Dos marcas para un estado
                 no son más claras: son dos. Se conserva la nuestra, que es la
                 del sistema de diseño y la misma que la Mac, y se apaga la
                 nativa poniendo en cero lo que la dibuja. Los valores de origen
                 están en `generic.xaml` del Windows App SDK; acá se pisan solo
                 para ESTA cuadrícula, no para toda la app.

                 El hover se conserva, y se iguala el de una tarjeta marcada al
                 de una sin marcar: quién está seleccionado lo dice el borde, no
                 el fondo.

                 En ALTO CONTRASTE no se pisa nada, a propósito: ahí el fondo de
                 selección del sistema no es decoración sino la señal que el modo
                 promete, y usa los colores que el usuario eligió. En ese modo
                 conviven las dos marcas, y está bien que así sea. -->
            <GridView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedDisabled" Color="Transparent" />
                            <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver"
                                            ResourceKey="SubtleFillColorSecondaryBrush" />
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Light">
                            <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedDisabled" Color="Transparent" />
                            <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver"
                                            ResourceKey="SubtleFillColorSecondaryBrush" />
                        </ResourceDictionary>

                        <!-- Alto contraste: sin pisar nada. -->
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </GridView.Resources>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:MediaCard">
                    <StackPanel Width="168" Margin="0,0,12,16" Spacing="6"
                                AutomationProperties.Name="{x:Bind Title}"
                                DoubleTapped="Card_DoubleTapped"
                                PointerEntered="Card_PointerEntered"
                                PointerExited="Card_PointerExited">
                        <Grid Width="152" Height="152" CornerRadius="6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <!-- Sin imagen no se deja un cuadro vacío: la
                                 inicial dice de qué tarjeta se trata. -->
                            <TextBlock Text="{x:Bind Initial}"
                                       FontSize="44"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{x:Bind HasCover, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />
                            <!-- La portada se carga por el DATO de la celda, no
                                 por su carga inicial: desde ST-201 la cuadrícula
                                 se actualiza en su lugar, así que un contenedor
                                 puede pasar a mostrar otra tarjeta sin volver a
                                 cargarse — y con `Loaded` se quedaría con la
                                 portada anterior. Es el mismo reciclaje que ya
                                 se veía al desplazarse. -->
                            <Image Stretch="UniformToFill"
                                   Visibility="{x:Bind HasCover, Converter={StaticResource BoolToVisibility}}"
                                   DataContextChanged="Cover_DataContextChanged"
                                   Loaded="Cover_Loaded"
                                   Unloaded="Cover_Unloaded" />

                            <!-- Marca de seleccionado: va encima de la portada,
                                 así que no puede depender del contraste con la
                                 imagen. -->
                            <Border BorderThickness="3" CornerRadius="6"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <!-- R2-1 (ST-120): sin nada seleccionado no se ve
                                 ninguna casilla; al pasar el cursor aparece la
                                 de esa tarjeta; con algo seleccionado, todas.
                                 Se oculta con OPACIDAD y no con Visibility para
                                 que la tarjeta no dé un salto al aparecer, y por
                                 eso hay que apagarle el clic aparte: una casilla
                                 invisible que igual se puede marcar es peor que
                                 una visible. -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="6" CornerRadius="4" Padding="2"
                                    Opacity="{x:Bind ShowsSelectionBox, Mode=OneWay, Converter={StaticResource BoolToOpacity}}"
                                    IsHitTestVisible="{x:Bind ShowsSelectionBox, Mode=OneWay}"
                                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                                <!-- ST-202: la casilla ya no escribe en la
                                     tarjeta, porque la selección la lleva el
                                     control. `Click` (que también sale con la
                                     barra espaciadora, así que el teclado y el
                                     lector de pantalla siguen sirviendo) alterna
                                     ESA tarjeta dentro de `SelectedItems`, y de
                                     ahí vuelve `IsSelected`. -->
                                <CheckBox MinWidth="0" Padding="0"
                                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                          Click="SelectionBox_Click"
                                          Tapped="SelectionBox_Tapped"
                                          AutomationProperties.Name="{x:Bind Title}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{x:Bind Subtitle}"
                                   Style="{StaticResource AuraCaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- El recuadro que se dibuja. Encima de todo y sin recibir eventos: es
             una marca, no un control. -->
        <Canvas Grid.Row="2" x:Name="MarqueeLayer" IsHitTestVisible="False">
            <Rectangle x:Name="MarqueeBox" Visibility="Collapsed" Opacity="0.35"
                       Fill="{ThemeResource AccentFillColorSecondaryBrush}"
                       Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                       StrokeThickness="1" />
        </Canvas>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="440"
                    Visibility="{x:Bind ViewModel.ShowsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind ViewModel.DropHint, Mode=OneWay}"
                       Style="{StaticResource AuraSecondaryTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.SectionRule, Mode=OneWay}"
                       Style="{StaticResource AuraCaptionTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,8,12,0" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                <!-- ST-202: en Álbumes, el resumen al estilo de la barra del
                     Finder (ST-063), armado por `StatusSummaryModel` y escrito
                     con rebote desde la página. En las demás cuadrículas siguen
                     el conteo y el "N seleccionados" de siempre. -->
                <TextBlock x:Name="StatusTotal"
                           Visibility="{x:Bind ViewModel.ShowsStatusSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource AuraCaptionTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.ShowsStatusSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}"
                           Style="{StaticResource AuraCaptionTextStyle}" />

                <TextBlock x:Name="StatusSelection" Grid.Column="1"
                           Visibility="{x:Bind ViewModel.ShowsStatusSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource AuraCaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.ShowsStatusSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}"
                           Style="{StaticResource AuraCaptionTextStyle}" />
                <controls:LibraryStatusStrip Grid.Column="2" HorizontalAlignment="Right"
                                             Library="{x:Bind ViewModel.Library, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- ST-171: encima de la página mientras la biblioteca no esté. No
             reemplaza nada — cuando el disco vuelve se apaga solo. -->
        <controls:LibraryUnavailableView Grid.Row="0" Grid.RowSpan="4"
                                         Library="{x:Bind ViewModel.Library, Mode=OneWay}" />
    </Grid>
</Page>
