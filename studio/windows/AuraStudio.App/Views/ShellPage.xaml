<Page
    x:Class="AuraStudio.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:conv="using:AuraStudio.App.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </Page.Resources>

    <!--
        Fondo transparente a propósito: el Mica de la ventana tiene que
        atravesar la página. Un Background opaco acá lo taparía.

        La jerarquía repite la barra lateral de macOS (Música/Video/Fotos como
        grupos con subsecciones). Las subsecciones no llevan icono: en Fluent
        la sangría ya expresa la jerarquía, y repetir iconos parecidos entre
        hermanos resta legibilidad.
    -->
    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    OpenPaneLength="248"
                    SelectionChanged="NavView_SelectionChanged"
                    Loaded="NavView_Loaded">

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="4,0,12,0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}">
                <FontIcon Glyph="&#xE955;" FontSize="16" />
                <TextBlock Text="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource AuraSectionTitleTextStyle}" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>

            <NavigationViewItem Tag="general" Content="{x:Bind res:AppStrings.NavGeneral}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="music"
                                Content="{x:Bind res:AppStrings.NavMusic}"
                                SelectsOnInvoked="False"
                                IsExpanded="True"
                                IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Tag="music.artists" Content="{x:Bind res:AppStrings.NavArtists}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="music.albums" Content="{x:Bind res:AppStrings.NavAlbums}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="music.songs" Content="{x:Bind res:AppStrings.NavSongs}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="music.playlists" Content="{x:Bind res:AppStrings.NavPlaylists}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem Tag="video"
                                Content="{x:Bind res:AppStrings.NavVideo}"
                                SelectsOnInvoked="False"
                                IsExpanded="True"
                                IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE714;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Tag="video.movies" Content="{x:Bind res:AppStrings.NavMovies}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="video.series" Content="{x:Bind res:AppStrings.NavSeries}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="video.clips" Content="{x:Bind res:AppStrings.NavClips}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="video.all" Content="{x:Bind res:AppStrings.NavAllVideos}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem Tag="photos"
                                Content="{x:Bind res:AppStrings.NavPhotos}"
                                SelectsOnInvoked="False"
                                IsExpanded="True"
                                IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Tag="photos.photos" Content="{x:Bind res:AppStrings.NavPhotosPhotos}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="photos.images" Content="{x:Bind res:AppStrings.NavPhotosImages}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="photos.ai" Content="{x:Bind res:AppStrings.NavPhotosAI}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                    <NavigationViewItem Tag="photos.all" Content="{x:Bind res:AppStrings.NavAllPhotos}"
                                        IsEnabled="{x:Bind ViewModel.LibraryEnabled, Mode=OneWay}" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <!-- Extras nunca se bloquea: ahí vive la elección de firmware, que
                 hace falta justamente con un iPod de fábrica (ST-047). -->
            <NavigationViewItem Tag="extras" Content="{x:Bind res:AppStrings.NavExtras}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8A9;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem Tag="extras.themes" Content="{x:Bind res:AppStrings.NavThemes}" />
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <!-- R3-2: Sincronizar YA NO es una sección. La barra lateral es la
                 de macOS (`ContentView.swift` → `SidebarSection`, que no tiene
                 un caso para sync), y la sincronización vive donde se decide:
                 en General, junto al estado del iPod y a lo que ocupa. Tener
                 una sección aparte obligaba a irse de la vista del dispositivo
                 justo para actuar sobre el dispositivo. -->
            <NavigationViewItem Tag="installer" Content="{x:Bind res:AppStrings.NavInstaller}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Un elemento deshabilitado siempre explica qué falta (ST-053):
                 la barra dice por qué la biblioteca no está disponible. -->
            <InfoBar Grid.Row="0"
                     Margin="24,12,24,0"
                     IsOpen="{x:Bind ViewModel.ShowLibraryLockedNote, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.LibraryLockedReason}" />

            <!-- ST-211: el aviso de versión nueva de la app. Franja, NO diálogo:
                 la app no es un canal de marketing y no interrumpe. Se puede
                 cerrar, y cerrada no vuelve por esa misma versión. -->
            <InfoBar Grid.Row="1"
                     Margin="24,12,24,0"
                     IsOpen="{x:Bind ViewModel.Updates.IsAnnouncing, Mode=TwoWay}"
                     Severity="Informational"
                     Title="Actualización de Aura Studio"
                     Message="{x:Bind ViewModel.Updates.AnnouncementMessage, Mode=OneWay}"
                     CloseButtonClick="AppUpdate_Dismissed">
                <InfoBar.ActionButton>
                    <Button Content="Descargar" Click="AppUpdateDownload_Click"
                            Visibility="{x:Bind ViewModel.Updates.CanDownload, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{x:Bind ViewModel.Updates.IsDownloading, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                </InfoBar.ActionButton>

                <!-- Las notas viven en la página del Release y no se duplican
                     dentro de la app: ya están escritas y mantenidas ahí. -->
                <HyperlinkButton Content="Ver qué hay de nuevo" Click="AppUpdateNotes_Click"
                                 Margin="0,0,0,8" />
            </InfoBar>

            <Frame x:Name="ContentFrame" Grid.Row="2" />
        </Grid>

    </NavigationView>
</Page>
