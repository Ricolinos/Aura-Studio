<Page
    x:Class="AuraStudio.App.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:vm="using:AuraStudio.App.ViewModels">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </Page.Resources>
    <ScrollViewer>
        <Grid Margin="{StaticResource AuraPageMargin}" MaxWidth="{StaticResource AuraContentMaxWidth}"
              MinWidth="620" HorizontalAlignment="Left"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
            <StackPanel>
                <TextBlock Text="Temas" Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="Cambia cómo se ve Aura en tu iPod" Style="{StaticResource AuraSecondaryTextStyle}" />
                <TextBlock Text="{Binding DeviceMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <!-- ===================== Instalados ===================== -->
            <ListView Grid.Row="2" ItemsSource="{Binding Themes}" SelectionMode="None"
                      ContextRequested="Themes_ContextRequested"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                                           Style="{StaticResource AuraCaptionTextStyle}" />
                                <!-- Un tema roto se muestra igual, con el motivo: esconderlo
                                     dejaría al usuario sin entender por qué el que copió
                                     no aparece. -->
                                <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap"
                                           Style="{StaticResource AuraCaptionTextStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Visibility="{x:Bind HasReason, Converter={StaticResource BoolToVisibility}}" />
                                <!-- La regla de licencia se dice, no se esconde (ST-003). -->
                                <TextBlock Text="{x:Bind ShareBlockedReason}" TextWrapping="Wrap"
                                           Style="{StaticResource AuraCaptionTextStyle}"
                                           Visibility="{x:Bind CanShare, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="Activar" Tag="{x:Bind Id}" Click="Activate_Click"
                                        IsEnabled="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                                <Button Content="Compartir…" Tag="{x:Bind Id}" Click="Share_Click"
                                        IsEnabled="{x:Bind CanShare}" />
                                <Button Content="Eliminar" Tag="{x:Bind Id}" Click="Remove_Click"
                                        IsEnabled="{x:Bind CanRemove}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

            <!-- ===================== Construir uno ===================== -->
            <Border Grid.Row="4" Style="{StaticResource AuraCardStyle}"
                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Construir un tema" Style="{StaticResource AuraSectionTitleTextStyle}" />
                    <TextBlock Text="Aura Studio arma el paquete desde una carpeta de assets ya generados con el design-system del firmware (fuentes .fnt y máscaras de íconos). No convierte fuentes ni íconos de tu computadora."
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Elegir carpeta…" Click="ChooseSourceFolder_Click" />
                        <TextBlock Text="{Binding NewThemeSourceFolder}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource AuraCaptionTextStyle}" />
                    </StackPanel>

                    <TextBox Header="Nombre" Text="{Binding NewThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Autor" Text="{Binding NewThemeAuthor, Mode=TwoWay}" />

                    <CheckBox Content="Usa material de licencia restringida (solo para mi uso personal)"
                              IsChecked="{Binding NewThemeIsRestricted, Mode=TwoWay}" />
                    <TextBlock Text="Márcalo si el tema usa fuentes o íconos que no puedes redistribuir, como SF Pro o SF Symbols. El tema se instala igual en tu iPod, pero Aura Studio no te va a dejar compartirlo."
                               Style="{StaticResource AuraCaptionTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding BuildHint, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource AuraCaptionTextStyle}" />

                    <Button Content="Construir e instalar" Click="Build_Click"
                            Style="{StaticResource AuraPrimaryButtonStyle}"
                            IsEnabled="{Binding CanBuild, Mode=OneWay}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
