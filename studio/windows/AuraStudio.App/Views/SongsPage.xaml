<Page
    x:Class="AuraStudio.App.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:controls="using:AuraStudio.App.Controls"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </Page.Resources>

    <!-- La fila de la tabla es la única que crece ("*"): antes el contenedor de
         la tabla abarcaba también una fila "Auto", que se mide con altura
         infinita — por eso la tabla nunca recibía un alto acotado y la rueda
         del mouse no movía nada. -->
    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Encabezado -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                           Style="{StaticResource AuraSecondaryTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Bind res:AppStrings.LibraryAddFiles}" Click="AddFiles_Click" />
                <Button Content="{x:Bind res:AppStrings.LibraryAddFolder}" Click="AddFolder_Click" />

                <!-- Solo favoritos: un botón de dos estados, no una casilla
                     escondida en un menú (es un filtro que se prende y apaga
                     seguido). -->
                <ToggleButton IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}"
                              ToolTipService.ToolTip="{x:Bind res:AppStrings.LibraryFavoritesOnly}"
                              AutomationProperties.Name="{x:Bind res:AppStrings.LibraryFavoritesOnly}"
                              Checked="Favorites_Toggled" Unchecked="Favorites_Toggled">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{x:Bind res:Glyphs.HeartFilled}" />
                </ToggleButton>

                <!-- §11: el MISMO menú que sale del clic derecho en el
                     encabezado. Una sola fuente, en Core. -->
                <Button ToolTipService.ToolTip="{x:Bind res:AppStrings.LibrarySortBy}"
                        AutomationProperties.Name="{x:Bind res:AppStrings.LibrarySortBy}"
                        Click="HeaderMenu_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{x:Bind res:Glyphs.Sort}" />
                </Button>

                <Button Content="Elementos parecidos" Click="Similar_Click"
                        ToolTipService.ToolTip="Busca canciones, fotos y videos que parezcan repetidos" />

                <Button Content="Completar en línea" Click="Enrich_Click"
                        IsEnabled="{x:Bind ViewModel.Library.IsEnriching, Mode=OneWay, Converter={StaticResource InvertBool}}"
                        ToolTipService.ToolTip="Busca álbum, año, carátula y letra de lo que esté incompleto" />

                <Button x:Name="ColumnsButton" ToolTipService.ToolTip="{x:Bind res:AppStrings.LibraryColumns}"
                        AutomationProperties.Name="{x:Bind res:AppStrings.LibraryColumns}">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{x:Bind res:Glyphs.Columns}" />
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="420">
                                <StackPanel Spacing="8" MinWidth="260">
                                    <TextBlock Text="{x:Bind res:AppStrings.LibraryColumnsDetail}"
                                               Style="{StaticResource AuraCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="ColumnOptions" Spacing="2" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Lo que pasó al soltar: se dice, no se calla -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.Library.LastDropMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                 Message="{x:Bind ViewModel.Library.LastDropMessage, Mode=OneWay}"
                 Severity="Informational"
                 Margin="0,0,0,12" />

        <!-- Encabezado y filas dentro del MISMO desplazamiento horizontal: si
             se desplazan por separado, los rótulos dejan de coincidir con sus
             columnas en cuanto uno se mueve. El ancho explícito es lo que hace
             que las últimas columnas se puedan alcanzar en vez de quedar
             cortadas contra el borde de la ventana. -->
        <!-- Este contenedor desplaza SOLO en horizontal, y así tiene que
             quedar: el que desplaza vertical es la lista de adentro, que es la
             que recibe la rueda del mouse por estar más adentro. Si este
             también desplazara vertical, mediría su contenido con altura
             infinita y la lista se quedaría sin alto acotado. -->
        <ScrollViewer x:Name="TableScroller" Grid.Row="2"
                      PointerWheelChanged="TableScroller_PointerWheelChanged"
                      HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <!-- Alineado a la izquierda: con un ancho explícito, el contenedor
                 se centraría y la tabla quedaría flotando en medio de la
                 ventana en cuanto sobra espacio. -->
            <Grid Width="{x:Bind ViewModel.TotalWidth, Mode=OneWay}" RowDefinitions="Auto,*"
                  HorizontalAlignment="Left">

                <!-- §11: el encabezado también abre el menú, como en macOS. -->
                <Border ContextRequested="Header_ContextRequested"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="TitleHeader_Click" Padding="0" Background="Transparent"
                                BorderThickness="0" Width="{x:Bind ViewModel.TitleWidth}"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.TitleHeader}" FontWeight="SemiBold" />
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.TitleSortGlyph, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Headers, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SongHeader">
                                    <Button Click="ColumnHeader_Click" Tag="{x:Bind Column}"
                                            Padding="0" Background="Transparent" BorderThickness="0"
                                            Width="{x:Bind Width}" HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind ShowsGlyph, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="{x:Bind Glyph}"
                                                       Visibility="{x:Bind ShowsGlyph, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10"
                                                       VerticalAlignment="Center" Text="{x:Bind SortGlyph}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- La lista es la que desplaza vertical, y por eso es la que
                     recibe la rueda: es la de más adentro. -->
                <ListView x:Name="RowsList" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                          SelectionMode="Extended"
                          SelectionChanged="Rows_SelectionChanged"
                          ContextRequested="Rows_ContextRequested">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                            <TextBlock Text="{x:Bind Title}" Width="260"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind SourcePath}" />
                            <ItemsControl ItemsSource="{x:Bind Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SongCell">
                                        <Grid Width="{x:Bind Width}">
                                            <TextBlock Text="{x:Bind Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind IsFavoriteColumn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}" />
                                            <TextBlock FontFamily="Segoe Fluent Icons"
                                                       Text="{x:Bind FavoriteGlyph}"
                                                       AutomationProperties.Name="{x:Bind FavoriteLabel}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind IsFavoriteColumn, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>

        <!-- Vacío: se explica POR QUÉ está vacío -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind ViewModel.ShowsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                       Style="{StaticResource AuraSecondaryTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{x:Bind res:AppStrings.LibrarySectionOnlyItsTypeMusic}"
                       Style="{StaticResource AuraCaptionTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- Barra de estado -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,8,12,0" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Style="{StaticResource AuraCaptionTextStyle}" />
                <controls:LibraryStatusStrip Grid.Column="1" HorizontalAlignment="Right"
                                             Library="{x:Bind ViewModel.Library, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- ST-171: encima de la página mientras la biblioteca no esté. No
             reemplaza nada — cuando el disco vuelve se apaga solo. -->
        <controls:LibraryUnavailableView Grid.Row="0" Grid.RowSpan="4"
                                         Library="{x:Bind ViewModel.Library, Mode=OneWay}" />
    </Grid>
</Page>
