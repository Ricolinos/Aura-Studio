<Page
    x:Class="AuraStudio.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AuraStudio.App.Controls"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels"
    xmlns:str="using:AuraStudio.Core.Resources">

    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Bind res:AppStrings.NavPlaylists}"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="{x:Bind str:Strings.Get('playlists-page.listas-armadas-con-canciones-biblioteca')}"
                           Style="{StaticResource AuraSecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{x:Bind str:Strings.Get('playlists-page.nueva-lista')}" Click="New_Click" Style="{StaticResource AuraPrimaryButtonStyle}" />
                <Button Content="{x:Bind str:Strings.Get('playlists-page.importar-m3u')}" Click="Import_Click" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.LastMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                 Message="{x:Bind ViewModel.LastMessage, Mode=OneWay}"
                 Severity="Informational" Margin="0,0,0,12" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource AuraCaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Bind str:Strings.Get('playlists-page.renombrar')}" Tag="{x:Bind Id}" Click="Rename_Click" />
                        <Button Grid.Column="2" Content="{x:Bind str:Strings.Get('playlists-page.exportar')}" Tag="{x:Bind Id}" Click="Export_Click" />
                        <Button Grid.Column="3" Content="{x:Bind str:Strings.Get('playlists-page.eliminar')}" Tag="{x:Bind Id}" Click="Delete_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Bind str:Strings.Get('playlists-page.todavia-tienes-listas')}"
                       Style="{StaticResource AuraSecondaryTextStyle}" TextAlignment="Center" />
            <TextBlock Text="{x:Bind str:Strings.Get('playlists-page.crea-nueva-o-importa-archivo-m3u')}"
                       Style="{StaticResource AuraCaptionTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,8,12,0" Margin="0,8,0,0">
            <controls:LibraryStatusStrip Library="{x:Bind ViewModel.Library, Mode=OneWay}"
                                         HorizontalAlignment="Right" />
        </Border>

        <!-- ST-171: encima de la página mientras la biblioteca no esté. No
             reemplaza nada — cuando el disco vuelve se apaga solo. -->
        <controls:LibraryUnavailableView Grid.Row="0" Grid.RowSpan="4"
                                         Library="{x:Bind ViewModel.Library, Mode=OneWay}" />
    </Grid>
</Page>
