<Page
    x:Class="AuraStudio.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:res="using:AuraStudio.App.Resources"
    xmlns:vm="using:AuraStudio.App.ViewModels">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    </Page.Resources>

    <Grid Margin="{StaticResource AuraPageMargin}" RowDefinitions="Auto,Auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Bind res:AppStrings.NavPlaylists}"
                           Style="{StaticResource AuraPageTitleTextStyle}" />
                <TextBlock Text="Listas armadas con canciones de tu biblioteca. Se copian al iPod al sincronizar."
                           Style="{StaticResource AuraSecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Nueva lista" Click="New_Click" Style="{StaticResource AuraPrimaryButtonStyle}" />
                <Button Content="Importar M3U…" Click="Import_Click" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.LastMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                 Message="{x:Bind ViewModel.LastMessage, Mode=OneWay}"
                 Severity="Informational" Margin="0,0,0,12" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource AuraCaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Renombrar" Tag="{x:Bind Id}" Click="Rename_Click" />
                        <Button Grid.Column="2" Content="Exportar" Tag="{x:Bind Id}" Click="Export_Click" />
                        <Button Grid.Column="3" Content="Eliminar" Tag="{x:Bind Id}" Click="Delete_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Todavía no tienes listas."
                       Style="{StaticResource AuraSecondaryTextStyle}" TextAlignment="Center" />
            <TextBlock Text="Crea una nueva, o importa un archivo .m3u/.m3u8 de otro programa. Las canciones que no estén en tu biblioteca se cuentan aparte, no se pierden en silencio."
                       Style="{StaticResource AuraCaptionTextStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,8,12,0" Margin="0,8,0,0">
            <TextBlock Text="{x:Bind ViewModel.Library.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource AuraCaptionTextStyle}" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Page>
