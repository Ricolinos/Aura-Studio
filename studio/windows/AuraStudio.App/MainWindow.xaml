<Window
    x:Class="AuraStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AuraStudio.App.Views"
    Title="Aura Studio">

    <!--
        La ventana no lleva interfaz: solo hospeda el armazón. Todo lo demás
        (respaldo Mica, tamaño/posición, tema y el enganche de WM_DEVICECHANGE)
        se resuelve en el code-behind, porque son cosas de ventana y no de XAML
        — `Window` en WinUI 3 no es un `FrameworkElement`.
    -->
    <views:ShellPage x:Name="Shell" />
</Window>
