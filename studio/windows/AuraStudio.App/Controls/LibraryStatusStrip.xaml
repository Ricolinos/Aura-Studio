<UserControl
    x:Class="AuraStudio.App.Controls.LibraryStatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters">

    <!--
        Franja de estado de la biblioteca (ST-164), compartida por Artistas,
        cuadrículas, Canciones y Listas: el mismo TextBlock de
        Library.StatusMessage que ya tenía cada página, más el botón
        "Cancelar" de ST-141 (macOS) que faltaba en Windows para detener la
        normalización de carátulas en curso.

        El botón queda Collapsed (ancho cero) fuera de una normalización, así
        que en el caso normal el layout no cambia nada respecto de un
        TextBlock suelto.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

        <!-- ST-203: lo que la app hace por su cuenta —cargar la biblioteca,
             medir tamaños— sale del centro de tareas y se muestra ACÁ, a la
             izquierda del mensaje. Antes ese trabajo o no se veía, o se
             anunciaba pisando StatusMessage, que es el renglón donde se
             contesta lo que el usuario acaba de pedir: una tarea que nadie pidió
             no puede tapar la respuesta a lo que sí se pidió.

             El bloque queda Collapsed cuando no hay ninguna tarea, así que en el
             caso normal el layout no cambia nada. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    Visibility="{x:Bind Tasks.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invertir}">
            <!-- Gira sin fingir un porcentaje: la precisión la da el "N de M"
                 de al lado, que sí se sabe. -->
            <ProgressRing Width="16" Height="16" IsActive="True" IsIndeterminate="True" />
            <TextBlock Text="{x:Bind Tasks.Current.Title, Mode=OneWay}"
                       Style="{StaticResource AuraCaptionTextStyle}" />
            <TextBlock Text="{x:Bind Tasks.Current.Detail, Mode=OneWay}"
                       Style="{StaticResource AuraCaptionTextStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Button Content="Detener"
                    Visibility="{x:Bind Tasks.Current.IsCancellable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Click="CancelTask_Click"
                    AutomationProperties.Name="Detener la tarea en curso" />
        </StackPanel>

        <!-- El botón suelto de ST-141 se fue con ST-203: la normalización de
             carátulas ahora es una tarea del centro, y se detiene con el mismo
             "Detener" que cualquier otra. Dos botones de cancelar al lado, para
             dos cosas distintas, es una pregunta que el usuario no debería
             tener que contestar. -->
        <TextBlock Text="{x:Bind Library.StatusMessage, Mode=OneWay}"
                   Style="{StaticResource AuraCaptionTextStyle}" />
    </StackPanel>
</UserControl>
