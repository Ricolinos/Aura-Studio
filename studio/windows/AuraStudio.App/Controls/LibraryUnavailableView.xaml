<UserControl
    x:Class="AuraStudio.App.Controls.LibraryUnavailableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AuraStudio.App.Converters"
    xmlns:res="using:AuraStudio.App.Resources"
    Visibility="{x:Bind Library.IsLibraryRootMissing, Mode=OneWay, Converter={StaticResource BoolToVisibilityOverlay}}">

    <!--
        ST-171: la biblioteca vive en un disco que no está conectado.

        Es un ESTADO, no un error. Antes salía un diálogo de "Algo salió mal"
        con una DirectoryNotFoundException, que además impedía construir el
        modelo de la biblioteca y volvía a saltar en cada navegación.

        Va encima del contenido de la página (mismo Grid, todas las filas) y no
        reemplaza nada: cuando el disco vuelve, se apaga solo y debajo está la
        página intacta. El Instalador y Extras no lo llevan a propósito — no
        necesitan la biblioteca y tienen que seguir usables.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityOverlay" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="560" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">

            <TextBlock Text="{x:Bind Library.RootMissingMessage, Mode=OneWay}"
                       Style="{StaticResource AuraSectionTitleTextStyle}"
                       TextWrapping="Wrap" />

            <!-- Lo primero que piensa cualquiera es "¿se borró mi música?". -->
            <TextBlock Text="{x:Bind res:AppStrings.LibraryRootMissingDetail}"
                       Style="{StaticResource AuraSecondaryTextStyle}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind res:AppStrings.LibraryRootRetry}"
                        Click="Retry_Click"
                        Style="{StaticResource AuraPrimaryButtonStyle}" />
                <Button Content="{x:Bind res:AppStrings.LibraryRootChoose}"
                        Click="Choose_Click" />
                <Button Content="{x:Bind res:AppStrings.LibraryRootCreate}"
                        Click="Create_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
