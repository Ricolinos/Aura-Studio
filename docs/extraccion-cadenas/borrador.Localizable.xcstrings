    "video-settings-view.separa-tus-videos-videos-series-pelicula": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa tus videos en Videos, Series y Películas para encontrarlos más fácil DENTRO de Aura Studio (la categoría se sugiere sola por duración al importar -- salvo \"Series\", que no tiene una heurística confiable y siempre se asigna a mano -- y se puede corregir en Biblioteca → Video). No cambia dónde quedan en el iPod: ahí siempre se copian juntos en \"Videos\", porque el reproductor del iPod todavía no navega por subcarpetas."
          }
        }
      }
    },
    "video-settings-view.todo-video-se-convierte-320x240-mpeg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo video se convierte a 320x240 MPEG-1/2 al sincronizar -- es el único formato que el iPod con Aura puede reproducir a velocidad completa (el chip de este iPod no puede decodificar H.264 ni formatos modernos). No es una preferencia: es una limitación real del hardware de 2007, así que aquí no hay nada que elegir."
          }
        }
      }
    },
    "welcome-view.entiendo-que-arranque-apple-se-borra": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que el arranque de Apple se borra"
          }
        }
      }
    },
    "welcome-view.firmware-original-apple-se-borra-arranqu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware original de Apple se borra del arranque del iPod. Una vez instalado, el iPod solo arranca %@; para volver a Apple hay que restaurarlo con iTunes/Finder desde cero. (El dual boot necesita un iPod en formato \"winpod\" -- restaurado desde Windows --, y un iPod restaurado desde Mac no lo es, asi que Aura Studio ya no lo ofrece.)"
          }
        }
      }
    },
    "welcome-view.marca-casilla-arriba-para-continuar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
