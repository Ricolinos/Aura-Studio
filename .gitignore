# Instrucciones locales para asistentes de codigo (Claude Code u otros).
# Viven solo en la maquina de cada quien; el repositorio es solo el
# codigo del proyecto.
CLAUDE.md

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Artefactos del firmware, descargados por scripts/fetch-firmware.sh
# desde un Release de Aura-Firmware (o copiados con --from-dir en
# desarrollo) -- ver CONTRATO-firmware-studio.md. Nunca versionados.
studio/AuraStudio/Vendor/firmware-dist/

# Fixtures de prueba generadas por tools/gen_test_media.sh
test-media/

# Xcode
studio/**/DerivedData/
studio/**/xcuserdata/
studio/**/*.xcuserstate
studio/**/build/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Archivos temporales
*.log
*.tmp
*.swp
.serena/
__pycache__/

# Paquetes armados por scripts/package-dmg.sh
dist/

# Estado local de tools/swift-test-por-lotes.sh -- qué tandas ya
# corrieron en ESTA Mac, nunca compartido (cada quien acumula el suyo).
tools/.swift-test-batches-results.tsv
tools/.swift-test-batch-*-failed.log
