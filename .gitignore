# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Builds del firmware (simulador y target)
firmware/build*/
firmware/rockbox/build*/

# Toolchain ARM y artefactos de rockboxdev.sh
firmware/toolchain/
/tmp-rbdev*/

# Salida generada del design system (regenerar con design-system/generate.py)
design-system/out/
design-system/.venv/
__pycache__/
*.pyc
# Copiado desde design-system/out/ por firmware/tools/build_sim.sh
firmware/rockbox/apps/aura/aura_tokens.h

# Xcode
studio/**/DerivedData/
studio/**/xcuserdata/
studio/**/*.xcuserstate
studio/**/build/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Archivos temporales
*.log
*.tmp
*.swp
